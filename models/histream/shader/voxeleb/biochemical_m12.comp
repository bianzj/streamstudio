// ==========================================================================
// 文件：biochemical_m12.comp
// 功能：VoxelEB 的叶片光合—气孔耦合（Farquhar C3 / von Caemmerer C4 + Ball-Berry），
//       对每个植被体元的受阳/阴两个节点求总初级生产力 GPP、净同化 A（NPP 槽位）、
//       叶片（表面）阻抗 rss 和胞间 CO2（ci）。荧光产额（MD12）部分已被注释掉，当前不输出荧光。
// 主要步骤（一个线程处理一个体元）：
//   1. 读取体元→实例→网格链接，按类别（土壤/建筑/水体/植被）分流；非植被只写 rss
//   2. 植被：检查叶片生化参数有效性；按冠层深度指数衰减 Vcmax（Vcmo = Vcmax·exp(kv·xl)）
//   3. 对受阳（kt=0）/阴（kt=1）节点：取叶温 Tc、吸收辐射 Q、叶面水汽压与 CO2
//   4. 温度订正（Arrhenius + 高温失活，Q10）→ 电子传输 J → C3/C4 同化 A
//   5. 由 cs、Ci、A 求叶片阻抗 rss；有效性检查，无效则写缺测（NaN）
//   6. 把 GPP/NPP、rss、ci 写回 voxelHeatFlux / voxelRsss / voxelAirs
// 数据流：输入 voxelTempes、voxelPnets、voxelAirs、leafBios、ubom.meteo；
//         输出 voxelHeatFlux.GPP*/NPP*、voxelRsss、voxelAirs.ci（供后续能量平衡着色器使用）。
// 与其他文件：公共辅助函数（biochemical*）在 shader/functions.glsl；
//         fluid_coupling.glsl 提供 localSoilResistance、localVaporPressureHpa 等本地环境量。
// 约定：温度 K（输入若 < 100 视为摄氏度并转换）；CO2/O2 分压内部用 bar；
//         光合速率 µmol m-2 s-1；活化能 kJ/mol；缺测值用 NaN（biochemicalMissing）。
// ==========================================================================

#version 460
#extension GL_ARB_separate_shader_objects : enable
#extension GL_EXT_nonuniform_qualifier : enable
#extension GL_GOOGLE_include_directive : enable
#extension GL_EXT_scalar_block_layout : enable
#extension GL_EXT_ray_tracing : enable
#extension GL_EXT_ray_query : enable
#extension GL_ARB_shader_clock : enable                 // Using clockARB
#extension GL_EXT_shader_image_load_formatted : enable  // The folowing extension allow to pass images as function parameters

#extension GL_NV_shader_sm_builtins : require     // Debug - gl_WarpIDNV, gl_SMIDNV
#extension GL_ARB_gpu_shader_int64 : enable       // Debug - heatmap value
#extension GL_EXT_shader_realtime_clock : enable  // Debug - heatmap timing

#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_debug_printf : enable
#extension GL_KHR_memory_scope_semantics:require
#extension GL_EXT_shader_atomic_float: require 


#define VOXELLST 1

#include "../bindingLayout.h"
#include "../parameters.h"
#include "../global.glsl"
#include "../functions.glsl"
#include "../nanovdb_info.glsl"
#include "fluid_coupling.glsl"
//#include "../shade_state.glsl"
// 模块：每个体元一个线程（gl_GlobalInvocationID.x = 体元缓冲区下标 bufferId0）。
// 对植被体元的受阳(sunlit)/阴(shaded)两个节点各求一次光合—气孔耦合（见 main 内步骤）。
layout(local_size_x = GROUP_SIZEX) in;

void main()
{


	float pmax, Vcmo, Tc, RH, O, SCOOP, Rdopt, Jmo, Vpmo,Tyear,
		Vpr, gbs, x, alpha, TREF, HARD, CRD, HAGSTAR, CGSTAR, HAJ, HDJ,
		DELTASJ, HAVCM, HDVC, DELTASVC, KCOP, HAKC, KOOP, HAKO, HAVPM,
		HDVP, DELTASVP, Q10KC, Q10KO, KPOP, Q10KP, dum1, dum2, Rd, SCO,
		Jmax, Vcmax, CKC, Kc, CKO, Ko, Vpmax, Kp, kf, kD, po0max, kPSII, fo0,
		kps, qLs, kd, NPQs, kds, kDs, Jms, po0, THETA, Q2, J, GSTAR, Ci, Cc,
		Wc, Wj, W, Ag, Ja, Cm, Rs, Rm, gam, Vpc, Vp, dum3, dum4, dum5, dum6,vcmax,
		dum7, dum8, dum9, dum10, a, b, c, d, Ac, Aj, ps, cs, A, p, Q, xl, rs, vcmo, Rdparam, Type, kNPQs, beta, leafM;

	// 步骤 1：声明局部量。kv 为冠层内 Vcmax 随深度的衰减系数，stress 为水分胁迫因子；
	// 植被体元会用 leafBios 里的值覆盖这里的全局缺省（RHOA/MAIR/STRESS/KV）。
	float rhoa,Mair,stress,kv;
	float rss,hcmax,Tsunlit,Tshaded;
	//int matId,type,structId,leafId,soilId;
	Canopy canopy;

    rhoa = RHOA;                               // [kg m-3]       specific mass of air
	Mair = MAIR;
	stress = STRESS;
	kv = KV;
    O = ubom.meteo.Oa;
    // 气压：meteo.p 单位 hPa，乘 100 后为 Pa。
    p = ubom.meteo.p * 100;


  ivec3 semiRange = ivec3(floor(setting.voxelSize.x/2.0 + 0.5),
                            floor(setting.voxelSize.y/2.0 + 0.5),
                            floor(setting.voxelSize.z/2.0 + 0.5)); 
   // 步骤 2：由线程号取体元链接，越界或无效（isValid==0）体元直接退出，
   // 并按体元 id 还原体元中心位置 voxelPos0（以体元为单位，x/z 以场景中心为原点，y 自地面向上）。
   uint spectralId,canopyId,bioId,typeId;
   uint bufferId0 = uint(gl_GlobalInvocationID.x);
   if(bufferId0 >= uint(setting.voxelCount)) return;
   if(voxelLinks[bufferId0].isValid == 0) return;
   uint instanceId0 = voxelLinks[bufferId0].instanceId;
   ivec3 voxelId0 = voxelLinks[bufferId0].voxelId;
   float scale = setting.scale;
   vec3 voxelPos0 =  vec3((voxelId0.x+0.5)-semiRange.x,
					(voxelId0.y+0.5),
					(voxelId0.z+0.5)-semiRange.z );
    
    // 步骤 3：体元 → 实例 → 网格，取得材质/冠层/生化参数下标与体元类别。
    InstanceLink instanceLink0 = instanceLinks[instanceId0];
    MeshLink meshLink0 = meshLinks[instanceLink0.meshId];


    spectralId = meshLink0.spectralId;
    canopyId = meshLink0.canopyId;
    bioId = meshLink0.bioId;
    typeId = meshLink0.type;

    // 说明：GPP/NPP 的输出复用 voxelHeatFlux 缓冲区；先全部清零，保证非植被体元输出为 0。
    // Carbon-process output shares the existing per-voxel flux buffer.  Set
    // non-vegetation voxels to zero before the vegetation branch below.
    voxelHeatFlux[bufferId0].GPPsunlit = 0.0;
    voxelHeatFlux[bufferId0].GPPshaded = 0.0;
    voxelHeatFlux[bufferId0].NPPsunlit = 0.0;
    voxelHeatFlux[bufferId0].NPPshaded = 0.0;

    // 步骤 4：按体元类别分支。土壤/建筑：只写本地土壤表面阻抗 rss（受阳、阴同值），不做光合；
    // 水体：用水体参数的 rss（不小于 0）；植被：进入下面的光合—气孔耦合计算。
    if(typeId == TYPE_SOIL || typeId == TYPE_BUILDING)
    {
        rss = localSoilResistance(bufferId0, bioId);
        atomicStore(voxelRsss[bufferId0].sunlit,rss, gl_ScopeDevice,gl_StorageSemanticsBuffer,gl_SemanticsRelaxed);
		atomicStore(voxelRsss[bufferId0].shaded,rss, gl_ScopeDevice,gl_StorageSemanticsBuffer,gl_SemanticsRelaxed);
    }
    else if(typeId == TYPE_WATER)
    {
        rss = max(waterSets[bioId].rss, 0.0);
        atomicStore(voxelRsss[bufferId0].sunlit, rss, gl_ScopeDevice,gl_StorageSemanticsBuffer,gl_SemanticsRelaxed);
        atomicStore(voxelRsss[bufferId0].shaded, rss, gl_ScopeDevice,gl_StorageSemanticsBuffer,gl_SemanticsRelaxed);
    }
    else if(typeId == TYPE_VEGETATION)
    {
        canopy = canopies[canopyId];
        // 参与介质冠层（按介质方式处理）不在此算叶片生化，直接退出（待核对）。
        if(isParticipatingMedium(canopy)) return;
        qLs = leafBios[bioId].qLs;
        NPQs = leafBios[bioId].kNPQs;
        vcmax = leafBios[bioId].Vcmax;
        Rdparam = leafBios[bioId].Rdparam;
        Type = leafBios[bioId].Type;
        beta = leafBios[bioId].beta;
        leafM = leafBios[bioId].leafM;
        Tyear = leafBios[bioId].Tyear;
		kv = leafBios[bioId].kV;
		stress = leafBios[bioId].stressfactor;
		hcmax = canopy.height;

        // 步骤 5：检查叶片生化参数的有效性（有限值、范围、光合途径 Type 只能为 3 或 4）。
        // 任何一项无效都会让后面该体元的输出写成缺测值（biochemicalMissing），而不是带着坏参数计算。
        bool leafParametersValid = biochemicalFinite(qLs) && qLs >= 0.0 && qLs <= 1.0 &&
            biochemicalFinite(NPQs) && NPQs >= 0.0 &&
            biochemicalFinite(vcmax) && vcmax >= 0.0 &&
            biochemicalFinite(Rdparam) && Rdparam >= 0.0 &&
            biochemicalFinite(beta) && beta >= 0.0 && beta <= 1.0 &&
            biochemicalFinite(leafM) && leafM >= 0.0 &&
            biochemicalFinite(kv) && kv >= 0.0 && biochemicalFinite(Tyear) &&
            biochemicalFinite(stress) && stress >= 0.0 && stress <= 1.0 &&
            biochemicalFinite(hcmax) && hcmax > 0.0 && (Type == 3.0 || Type == 4.0);

        // 步骤 6：冠层内 Vcmax 随深度指数衰减：xl = -(冠层顶深度)/冠高 ∈ [-1,0]，
        // 即顶部 xl=0、底部 xl=-1；Vcmo = Vcmax·exp(kv·xl)，kv 通常为正，故越深 Vcmax 越小（待核对符号）。
        // voxelPos0.y*scale 为体元中心高度（m）；参数无效时 xl 取 0 避免除以非法冠高。
        xl = leafParametersValid ? (hcmax - voxelPos0.y*scale)*(-1.0)/hcmax : 0.0;
		xl = clamp(xl,-1,0);
        Vcmo = vcmax * exp(kv*xl);
 
        // 步骤 7：取受阳/阴叶温。数值 < 100 判为摄氏度并加 273.15 转成 K（兼容两种单位的输入）。
        float Tsunlit,Tshaded;
        Tsunlit = voxelTempes[bufferId0].sunlit < 100.0 ?
            voxelTempes[bufferId0].sunlit + 273.15 : voxelTempes[bufferId0].sunlit;
        Tshaded = voxelTempes[bufferId0].shaded < 100.0 ?
            voxelTempes[bufferId0].shaded + 273.15 : voxelTempes[bufferId0].shaded;

		// 步骤 8：对两个节点循环：kt=0 受阳叶，kt=1 阴叶。
		for(int kt = 0;kt<2;kt++)
		{
			
			if(kt ==0 )
			{
				Tc = Tsunlit;
			}else
			{
				Tc = Tshaded;
			}

			// kt = 0 is sunlit; VoxelAir indexes [0] shaded, [1] sunlit.
			// voxelAirs 的状态下标与 kt 相反：[0] 阴、[1] 阳，故 state = 1 - kt。
			int state = 1 - kt;
			// Each node's first pass starts from this node's ambient air, not the
			// leaf-surface values left by the previous node.
			// 叶表面水汽压 es（hPa）与 CO2 浓度 cs（ppm）：能量迭代第 0 轮用体元环境空气值，
			// 之后沿用上一轮结果（叶表面值）。注意：RH 用叶温下的饱和水汽压归一并限制在 [0,1]。
			float esLeaf = setting.energyIteration == 0 ? localVaporPressureHpa(bufferId0) : voxelAirs[bufferId0].es[state];
			float csLeaf = setting.energyIteration == 0 ? localAmbientCo2Ppm(bufferId0) : voxelAirs[bufferId0].cs[state];
			RH = clamp(esLeaf / es_fun(Tc-273.15), 0.0, 1.0);
            // 单位换算：p(Pa)·1e-6 为 ppm 折算的分压(Pa)，再 ×1e-5 得 bar，合 p·1e-11（ppm → bar）。
            float ppmToBar = p * 1e-11;
			cs = csLeaf * ppmToBar;

			O = ubom.meteo.Oa;
			// O2 浓度（meteo.Oa，单位应为 mmol/mol）折算成分压（bar）。
			O = O * p * 1e-8;
			// 吸收辐射 Q（来自 voxelPnets，是否为 PAR 待核对）：阴叶只接受散射部分，阳叶额外加上直射部分。
			Q = voxelPnets[bufferId0].diffusePnet;
			if(kt == 0) Q += voxelPnets[bufferId0].directPnet;

            // 步骤 9：输入检查。叶温、气压、浓度、辐射任一非有限或越界，则该节点的 GPP、NPP、
            // voxelRsss（阻抗）与胞间 CO2（ci）全部写成缺测值，并跳过本节点（continue）。
            if(!leafParametersValid || !biochemicalFinite(Tc) || Tc <= 0.0 ||
               !biochemicalFinite(p) || p <= 0.0 ||
               !biochemicalFinite(ppmToBar) || ppmToBar <= 0.0 ||
               !biochemicalFinite(esLeaf) || esLeaf < 0.0 ||
               !biochemicalFinite(csLeaf) || csLeaf < 0.0 ||
               !biochemicalFinite(O) || O < 0.0 || !biochemicalFinite(RH) ||
               !biochemicalFinite(voxelPnets[bufferId0].directPnet) || voxelPnets[bufferId0].directPnet < 0.0 ||
               !biochemicalFinite(voxelPnets[bufferId0].diffusePnet) || voxelPnets[bufferId0].diffusePnet < 0.0 ||
               !biochemicalFinite(Q) || Q < 0.0)
            {
                float missing = biochemicalMissing();
                if(kt == 0)
                {
                    voxelHeatFlux[bufferId0].GPPsunlit = missing;
                    voxelHeatFlux[bufferId0].NPPsunlit = missing;
                    atomicStore(voxelRsss[bufferId0].sunlit, missing, gl_ScopeDevice,gl_StorageSemanticsBuffer,gl_SemanticsRelaxed);
                }
                else
                {
                    voxelHeatFlux[bufferId0].GPPshaded = missing;
                    voxelHeatFlux[bufferId0].NPPshaded = missing;
                    atomicStore(voxelRsss[bufferId0].shaded, missing, gl_ScopeDevice,gl_StorageSemanticsBuffer,gl_SemanticsRelaxed);
                }
                atomicStore(voxelAirs[bufferId0].ci[state], missing, gl_ScopeDevice,gl_StorageSemanticsBuffer,gl_SemanticsRelaxed);
                continue;
            }

			// 步骤 10：设定参考温度（25°C）下的光合参数：呼吸 Rdopt 为 Vcmo 的比例；
			// C3 的 Jmo = 2.68·Vcmo；C4 的 Jmo = 40/6·Vcmo，另有 PEP 羧化 Vpmo 与 bundle sheath 导度 gbs。
			// SCOOP 为 Rubisco 对 CO2/O2 的特异性因子（待核对单位）。
			SCOOP = 2862;
			Rdopt = Rdparam * Vcmo;
			if(Type < 3.5)
			{
				Jmo = Vcmo * 2.68;
			}else{
				Jmo = Vcmo * 40 / 6.0;
				Vpmo = Vcmo * 2.33;
				Vpr = 80;
				gbs = (0.0207 * Vcmo + 0.4806) * 1000.0;
				x = 0.4;
				alpha = 0;
			}

			//---------------------------------------------------------------------------------------------------------
			//% Parameters for voxelTempe corrections
			// 步骤 11：温度响应参数。各 HA*/HD* 为活化/失活能（kJ/mol），DELTAS* 为熵项（kJ/mol/K），
			// C3 取 Kattge & Knorr (2007)、Bernacchi et al. (2001)，C4 取 Massad et al. (2007)、Chen et al. (1994)。
			// Tyear 用于熵项的温度驯化（仅 C3）。
			TREF = 25 + 273.15;                             // [K]            reference voxelTempe for photosynthetic processes

			HARD = 46.39;                                 // [kJ/mol]       activation energy of Rd
			CRD = 1000 * HARD / (R*TREF);                   // []             scaling factor in RD response to voxelTempe

			HAGSTAR = 37.83;                                 // [kJ/mol]       activation energy of Gamma_star
			CGSTAR = 1000 * HAGSTAR / (R*TREF);                // []             scaling factor in GSTAR response to voxelTempe

			if (Type < 3.5)
			{
				// C3 species
				HAJ = 49.88;                                 // [kJ/mol]       activation energy of Jm (Kattge & Knorr 2007)
				HDJ = 200;                                   // [kJ/mol]       deactivation energy of Jm (Kattge & Knorr 2007)
				DELTASJ = (-0.75*Tyear + 660) / 1000;                // [kJ/mol/K]     entropy term for J  (Kattge and Knorr 2007)

				HAVCM = 71.51;                                 // [kJ/mol]       activation energy of Vcm (Kattge and Knorr 2007)
				HDVC = 200;                                   // [kJ/mol]       deactivation energy of Vcm (Kattge & Knorr 2007)
				DELTASVC = (-1.07*Tyear + 668) / 1000;                // [kJ/mol/K]     entropy term for Vcmax (Kattge and Knorr 2007)

				KCOP = 404.9;                                 // [umol/mol]     Michaelis-Menten constant for CO2 at ref temp (Bernacchi et al 2001)
				HAKC = 79.43;                                 // [kJ/mol]       activation energy of Kc (Bernacchi et al 2001)

				KOOP = 278.4;                                 // [mmol/mol]     Michaelis-Menten constant for O2  at ref temp (Bernacchi et al 2001)
				HAKO = 36.38;                                 // [kJ/mol]       activation energy of Ko (Bernacchi et al 2001)

			}
			else
			{
				// C4 species (values can be different as noted by von Caemmerer 2000)
				HAJ = 77.9;                                   // [kJ/mol]       activation energy of Jm  (Massad et al 2007)
				HDJ = 191.9;                                 // [kJ/mol]       deactivation energy of Jm (Massad et al 2007)
				DELTASJ = 0.627;                                 // [kJ/mol/K]     entropy term for Jm (Massad et al 2007). No data available on acclimation to voxelTempe.

				HAVCM = 67.29;                                 // [kJ/mol]       activation energy of Vcm (Massad et al 2007)
				HDVC = 144.57;                                // [kJ/mol]       deactivation energy of Vcm (Massad et al 2007)
				DELTASVC = 0.472;                                 // [kJ/mol/K]     entropy term for Vcm (Massad et al 2007). No data available on acclimation to voxelTempe.

				HAVPM = 70.37;                                 // [kJ/mol]       activation energy of Vpm  (Massad et al 2007)
				HDVP = 117.93;                                // [kJ/mol]       deactivation energy of Vpm (Massad et al 2007)
				DELTASVP = 0.376;                                 // [kJ/mol/K]     entropy term for Vpm (Massad et al 2007). No data available on acclimation to voxelTempe.

				KCOP = 944.;                                  // [umol/mol]     Michaelis-Menten constant for CO2 at ref temp (Chen et al 1994; Massad et al 2007)
				Q10KC = 2.1;                                   // []             Q10 for voxelTempe response of Kc (Chen et al 1994; Massad et al 2007)

				KOOP = 633.;                                  // [mmol/mol]     Michaelis-Menten constant for O2 at ref temp (Chen et al 1994; Massad et al 2007)
				Q10KO = 1.2;                                   // []             Q10 for voxelTempe response of Ko (Chen et al 1994; Massad et al 2007)

				KPOP = 82.;                                   // [umol/mol]     Michaelis-Menten constant of PEP carboxylase at ref temp (Chen et al 1994; Massad et al 2007)
				Q10KP = 2.1;                                   // []             Q10 for voxelTempe response of Kp (Chen et al 1994; Massad et al 2007)

			}

			//---------------------------------------------------------------------------------------------------------
			//% Corrections for effects of voxelTempe and non-stomatal limitations
			// 步骤 12：温度订正。dum1 = R·Tc、dum2 = R·TREF（kJ/mol，R 为气体常数 J/mol/K）。
			// Rd 用 Arrhenius 形式；SCO（Rubisco 对 CO2 特异性）随叶温订正（Bernacchi et al. 2001）。
			dum1 = R / 1000 * Tc;                                  // [kJ/mol]
			dum2 = R / 1000 * TREF;                               // [kJ/mol]

			Rd = Rdopt*exp(CRD - HARD / dum1);                  // [umol/m2/s]    mitochondrial respiration rates adjusted for voxelTempe (Bernacchi et al. 2001)
			SCO = SCOOP / exp(CGSTAR - HAGSTAR / dum1);            // []             Rubisco specificity for CO2 adjusted for voxelTempe (Bernacchi et al. 2001)

			// Jmax / Vcmax：Arrhenius 活化项 × 高温失活的峰值型修正（Kattge & Knorr 2007；Massad et al. 2007），
			// 乘 (1+exp(..TREF..)) 再除 (1+exp(..Tc..)) 保证 Tc=TREF 时回到参考值 Jmo / Vcmo。
			Jmax = Jmo * exp(HAJ*(Tc - TREF) / (TREF*dum1));
			Jmax = Jmax*(1. + exp((TREF*DELTASJ - HDJ) / dum2));
			Jmax = Jmax / (1. + exp((Tc*DELTASJ - HDJ) / dum1));     // [umol e-/m2/s] max electron transport rate at leaf voxelTempe (Kattge and Knorr 2007; Massad et al. 2007)

			Vcmax = Vcmo * exp(HAVCM*(Tc - TREF) / (TREF*dum1));
			Vcmax = Vcmax*(1 + exp((TREF*DELTASVC - HDVC) / dum2));
			Vcmax = Vcmax / (1 + exp((Tc*DELTASVC - HDVC) / dum1));    // [umol/m2/s]    max carboxylation rate at leaf voxelTempe (Kattge and Knorr 2007; Massad et al. 2007)



			////////////////////////////////////////////////////////////////////////////////////
			if (Type < 3.5)
			{
				// C3// species
				// 步骤 13：Michaelis 常数订正。C3 用 Arrhenius（Kc、Ko），Kc/Ko 先乘 1e-11·p、1e-8·p
				// 由 µmol/mol、mmol/mol 折算为 bar；C4 另算 PEP 羧化酶最大速率 Vpmax，
				// Kc、Ko、Kp 用 Q10 形式（pow(Q10, (Tc-TREF)/10)）。
				CKC = 1000 * HAKC / (R*TREF);                     // []             scaling factor in KC response to voxelTempe
				Kc = KCOP*exp(CKC - HAKC / dum1)*1e-11*p;     // [bar]          Michaelis constant of carboxylation adjusted for voxelTempe (Bernacchi et al. 2001)

				CKO = 1000 * HAKO / (R*TREF);                     // []             scaling factor in KO response to voxelTempe
				Ko = KOOP*exp(CKO - HAKO / dum1)*1e-8*p;      // [bar]          Michaelis constant of oxygenation adjusted for voxelTempe (Bernacchi et al. 2001)

			}
			else                                              // C4 species
			{
				Vpmax = Vpmo * exp(HAVPM*(Tc - TREF) / (TREF*dum1));
				Vpmax = Vpmax*(1 + exp((TREF*DELTASVP - HDVP) / dum2));
				Vpmax = Vpmax / (1 + exp((Tc*DELTASVP - HDVP) / dum1));//% [umol/m2/s]    max carboxylation rate at leaf voxelTempe (Massad et al. 2007)
				float temp = ((Tc - TREF) / 10.);
				Kc = KCOP*pow(Q10KC, temp)*1e-11*p;    // [bar]          Michaelis constant of carboxylation voxelTempe corrected (Chen et al 1994; Massad et al 2007)
				temp = ((Tc - TREF) / 10.);
				Ko = KOOP*pow(Q10KO, temp)*1e-8*p;     // [bar]          Michaelis constant of oxygenation  voxelTempe corrected (Chen et al 1994; Massad et al 2007)
				temp = ((Tc - TREF) / 10.);
				Kp = KPOP*pow(Q10KP, temp)*1e-11*p;    // [bar]          Michaelis constant of PEP carboxyl voxelTempe corrected (Chen et al 1994; Massad et al 2007)

			}

			//---------------------------------------------------------------------------------------------------------
			//% Define electron transport and fluorescence parameters
			// 步骤 14：PSII 电子传递与荧光参数（速率常数 s-1）。qLs（开放反应中心比例）与 NPQs
			// 把胁迫情景下的光化学速率 kps、热耗散 kDs、潜在电子传输上限 Jms 都折减；
			// THETA 为光响应曲线的凸度（Genty et al. 1989；Porcar-Castell 2011）。
			kf = 3.E7;                                    // [s-1]         rate constant for fluorescence
			kD = 1.E8;                                   // [s-1]         rate constant for thermal deactivation at Fm
			kd = 1.95E8;                                    // [s-1]         rate constant of energy dissipation in closed RCs (for theta=0.7 under un-stressed conditions)
			po0max = 0.88;                                     // [mol e-/E]    maximum PSII quantum yield, dark-acclimated in the absence of stress (Pfundel 1998)
			kPSII = (kD + kf) * po0max / (1. - po0max);             // [s-1]         rate constant for photochemisty (Genty et al. 1989)
			fo0 = kf / (kf + kPSII + kD);                        // [E/E]         reference dark-adapted PSII fluorescence yield under un-stressed conditions

			kps = kPSII * qLs;                              // [s-1]         rate constant for photochemisty under stressed conditions (Porcar-Castell 2011)
			kNPQs = NPQs * (kf + kD);                           // [s-1]         rate constant of sustained thermal dissipation (Porcar-Castell 2011)
			kds = kd * qLs;
			kDs = kD + kNPQs;
			Jms = Jmax * qLs;                               // [umol e-/m2/s] potential e-transport rate reduced for PSII photodamage
			po0 = kps / (kps + kf + kDs);                       // [mol e-/E]    maximum PSII quantum yield, dark-acclimated in the presence of stress
			THETA = (kps - kds) / (kps + kf + kDs);                  // []            convexity factor in J response to PAR

																	//---------------------------------------------------------------------------------------------------------
																	//% Calculation of electron transport rate
			// 步骤 15：电子传输速率 J：Q2 为被 PSII 吸收并转化的激发（beta 为 PSII 分配比例，po0 为量子产额），
			// J 取 theta·J² - (Q2+Jms)·J + Q2·Jms = 0 的较小根（数值稳定实现见 functions.glsl）。
			Q2 = beta * Q * po0;
			J = biochemicalElectronTransport(Q2, Jms, THETA);

																						//---------------------------------------------------------------------------------------------------------
																						//% Calculation of net photosynthesis
			if (Type < 3.5)                                           // C3 species, based on Farquhar model (Farquhar et al. 1980)
			{

				// 步骤 16a（C3，Farquhar 模型）：CO2 补偿点 GSTAR、由 Ball-Berry 得胞间 Ci（下限取 GSTAR），
				// Wc（Rubisco 限制）与 Wj（电子传递限制）取小者；Ag = (1 - GSTAR/Cc)·W，A = Ag - Rd；
				// Ja 为实际使用的电子传输速率，用于后面的 PSII 产额（Cc>0 的保护避免除零）。
				GSTAR = 0.5*O / SCO;                             // [bar]             CO2 compensation point in the absence of mitochondrial respiration
				Ci = biochemicalIntercellularCO2(cs, GSTAR, leafM, RH, stress);
				// [bar]             intercellular CO2 concentration from Ball-Berry model (Ball et al. 1987)
				Cc = Ci;                                        // [bar]             CO2 concentration at carboxylation sites (neglecting mesophyll resistance)

				Wc = Cc > 0.0 ? Vcmax * Cc / (Cc + Kc * (1 + O / Ko)) : 0.0;
				Wj = Cc > 0.0 ? J*Cc / (4.5*Cc + 10.5*GSTAR) : 0.0;

				W = min(Wc, Wj);                                // [umol/m2/s]       carboxylation rate
				Ag = Cc > 0.0 ? (1 - GSTAR / Cc) *W : 0.0;
				A = Ag - Rd;                                   // [umol/m2/s]       net photosynthesis rate
				Ja = Wj > 0.0 ? clamp(J*W / Wj, 0.0, J) : 0.0;

			}
			else                                             // C4 species, based on von Caemmerer model (von Caemmerer 2000)
			{
				// 步骤 16b（C4，von Caemmerer 2000 完整模型）：Ci 下限 9.9e-6·p·1e-5（约 9.9 ppm 折算为 bar），
				// Ac（酶限制）与 Aj（光限制）各自求一元二次方程（a、b、c 系数中 dum1~dum10 为复用的中间量），
				// A 取二者较小者；两者任一无效则记缺测。
				Ci = biochemicalIntercellularCO2(cs, 9.9e-6*(p*1e-5), leafM, RH, stress);
				// [bar]             intercellular CO2 concentration from Ball-Berry model (Ball et al. 1987)
				Cm = Ci;                                     // [bar]             mesophyll CO2 concentration (neglecting mesophyll resistance)
				Rs = 0.5 * Rd;                               // [umol/m2/s]       bundle sheath mitochondrial respiration (von Caemmerer 2000)
				Rm = Rs;                                     // [umol/m2/s]       mesophyll mitochondrial respiration
				gam = 0.5 / SCO;                               // []                half the reciprocal of Rubisco specificity for CO2

				Vpc = Vpmax * Cm / (Cm + Kp);                     // [umol/m2/s]       PEP carboxylation rate under limiting CO2 (saturating PEP)
				Vp = min(Vpc, Vpr);                            // [umol/m2/s]       PEP carboxylation rate

															// Complete model proposed by von Caemmerer (2000)
				dum1 = alpha / 0.047;                           // dummy variables, to reduce computation time
				dum2 = Kc / Ko;
				dum3 = Vp - Rm + gbs*Cm;
				dum4 = Vcmax - Rd;
				dum5 = gbs*Kc*(1 + O / Ko);
				dum6 = gam*Vcmax;
				dum7 = x*J / 2. - Rm + gbs*Cm;
				dum8 = (1. - x)*J / 3.;
				dum9 = dum8 - Rd;
				dum10 = dum8 + Rd * 7 / 3;

				a = 1. - dum1 * dum2;
				b = -(dum3 + dum4 + dum5 + dum1*(dum6 + Rd*dum2));
				c = dum4*dum3 - dum6*gbs*O + Rd*dum5;
				Ac = biochemicalQuadraticRoot(a, b, c, -1.0);

				a = 1.0 - 7.0 / 3.0 * gam*dum1;
				b = -(dum7 + dum9 + gbs*gam*O * 7 / 3. + dum1*gam*dum10);
				c = dum7*dum9 - gbs*gam*O*dum10;
				Aj = biochemicalQuadraticRoot(a, b, c, -1.0);

				A = biochemicalFinite(Ac) && biochemicalFinite(Aj) ? min(Ac, Aj) : biochemicalMissing();
				Ag = A + Rd;                                                            // [umol/m2/s]       gross photosynthesis

				Ja = J;                                      // [umole-/m2/s]     actual electron transport rate, CO2-limited


				// 若 A 受 Ac 限制，需重新由二次方程反求实际电子传输速率 Ja（上限不超过 J）；
				// 系数已整体乘以 A，避免补偿点附近 1/A 奇异（见下方原注释）。
				if (biochemicalFinite(A) && A == Ac && J > 0.0)
				{

					// ind=A==Ac;
                    // Multiply the whole polynomial by A before solving. This
                    // removes the artificial 1/A singularity at compensation.
					a = x*(1 - x) / 6.0;
					b = (1 - x) / 3.0 * (gbs*Cm - Rm - gbs*gam*O - A*(1 + alpha*gam / 0.047)) - x / 2.0 * (A + Rd);
					c = (A + Rd)*(Rm - gbs*Cm - 7.0*gbs*gam*O / 3.0) + A*(Rd + A)*(1 - 7.0*alpha*gam / 3.0 / 0.047);
					Ja = clamp(biochemicalQuadraticRoot(a, b, c, A < 0.0 ? -1.0 : 1.0), 0.0, J);

				}


				// Simplified model (von Caemmerer 2000), should be chosen ONLY if computation times are excessive
				//        dum3  =  Vp-Rm+gbs*Cm;
				//        dum4  =  Vcmax-Rd;
				//        dum7  =  x*J/2. - Rm + gbs*Cm;
				//        dum8  =  (1.-x)*J/3.;
				//        dum9  =  dum8 - Rd;
				//
				//        Ac    = min(dum3,dum4);                          // [umol/m2/s]       light saturated CO2 assimilation rate
				//        Aj    = min(dum7,dum9);                          // [umol/m2/s]       light-limited CO2 assimilation rate
				//
				//        A     = min(Ac,Aj);                              // [umol/m2/s]       net photosynthesis rate
				//        Ja  = J * A/ Aj;                               // [umole-/m2/s]     actual electron transport rate (simple empirical formulation based on results)

			}

            // Closed stomata and darkness have zero gross assimilation while
            // mitochondrial respiration continues. This also covers qLs=0.
            // 步骤 17：黑暗或气孔关闭等极端情形的统一处理：总同化为 0、净同化 = -Rd（呼吸仍进行）。
            if(Q == 0.0 || J == 0.0 || leafM == 0.0 || RH == 0.0 || stress == 0.0 || cs == 0.0)
            {
                Ag = 0.0;
                A = -Rd;
                Ja = 0.0;
            }
            // 步骤 18：由 cs、Ci 和净同化 A 反推叶片阻抗 rss（A<=0 时取 625000 的大阻抗，
            // 单位为 s m-1，待核对）；ciPpm 为胞间 CO2 折回 ppm，供后续步骤写回 voxelAirs。
            rss = biochemicalResistance(cs, Ci, A, rhoa, Mair, p);
            float ciPpm = Ci / ppmToBar;
            // 步骤 19：结果有效性检查：先检查中间速率（ratesValid），再检查输出（resultValid）。
            // 任何一项非有限或越界，Ag、A、Ci、ciPpm、rss 全部置缺测（NaN），避免把假的碳通量传给下游。
            bool ratesValid = biochemicalFinite(Vcmo) && Vcmo >= 0.0 &&
                biochemicalFinite(Vcmax) && Vcmax >= 0.0 &&
                biochemicalFinite(Jmax) && Jmax >= 0.0 &&
                biochemicalFinite(po0) && po0 >= 0.0 && po0 <= 1.0 &&
                biochemicalFinite(THETA) && THETA >= 0.0 && THETA <= 1.0 &&
                biochemicalFinite(cs) && cs >= 0.0 && biochemicalFinite(RH) &&
                biochemicalFinite(SCO) && SCO > 0.0 &&
                biochemicalFinite(Kc) && Kc > 0.0 && biochemicalFinite(Ko) && Ko > 0.0 &&
                biochemicalFinite(kNPQs) && biochemicalFinite(kDs) &&
                (Type == 3.0 || (biochemicalFinite(Vpmax) && Vpmax >= 0.0 &&
                                 biochemicalFinite(Kp) && Kp > 0.0));
            bool resultValid = ratesValid && biochemicalFinite(Ag) && biochemicalFinite(A) &&
                biochemicalFinite(Ci) && biochemicalFinite(ciPpm) && ciPpm >= 0.0 &&
                biochemicalFinite(rss) && rss >= 0.0 &&
                biochemicalFinite(Rd) && Rd >= 0.0 && biochemicalFinite(J) && biochemicalFinite(Ja);
            if(!resultValid)
            {
                Ag = biochemicalMissing();
                A = biochemicalMissing();
                Ci = biochemicalMissing();
                ciPpm = biochemicalMissing();
                rss = biochemicalMissing();
            }

			if(kt == 0)
			{
				voxelHeatFlux[bufferId0].GPPsunlit = resultValid ? max(0.0, Ag) : biochemicalMissing();
				voxelHeatFlux[bufferId0].NPPsunlit = A;
			}else
			{
				voxelHeatFlux[bufferId0].GPPshaded = resultValid ? max(0.0, Ag) : biochemicalMissing();
				voxelHeatFlux[bufferId0].NPPshaded = A;
			}

			//---------------------------------------------------------------------------------------------------------
			//% Calculation of PSII quantum yield and fluorescence
			// PSII 实际量子产额 ps（当前只算出，后面荧光产额 fs 的计算已被注释掉，未写出）。
			ps = beta*Q > 0.0 ? Ja / (beta*Q) : 0.0;
														//fs   = MD12(ps,Ja,Jms,kps,kf,kds,kDs);            // [E/E]         PSII fluorescence yield
														// eta    = fs/fo0;                                   // []            scaled PSII fluorescence yield


														//% JP add
														// [g mol-1]      molecular mass of dry air

			if(kt == 0)
			{
				atomicStore( voxelRsss[bufferId0].sunlit,rss, gl_ScopeDevice,gl_StorageSemanticsBuffer,gl_SemanticsRelaxed);
			}else
			{
				atomicStore( voxelRsss[bufferId0].shaded,rss, gl_ScopeDevice,gl_StorageSemanticsBuffer,gl_SemanticsRelaxed);
			}
			// 步骤 20：写回 rss（voxelRsss.sunlit/shaded，已在上面按 kt 写出）与胞间 CO2（ppm，按 state 下标），
			// 供能量平衡迭代读取，并在下一轮能量迭代中作为叶表面 CO2/阻抗的初值（待核对读取方）。
			atomicStore( voxelAirs[bufferId0].ci[state],ciPpm, gl_ScopeDevice,gl_StorageSemanticsBuffer,gl_SemanticsRelaxed);

		}
    }





