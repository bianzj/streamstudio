// ==========================================================================
// 文件：voxelrad_direct_TIR.comp
// 功能：VoxelEB 中热红外（TIR）波段的“直射”长波分量（directTrad）计算着色器。
//       当前实现已禁用：天空向下长波 Rli 被视为半球均匀入射，由 voxelrad_diffuse_TIR_single.comp
//       计入 diffuseTrad，为避免重复计算，本文件在清零 directTrad 后立即 return。
// 主要模块/步骤：
//   1. 编译期设置：扩展、include、波段常量（NUM_VNIR=2001 为 TIR 波段起点，NUM_BAND=2002）
//   2. main：每线程一个体元；读取体元/网格/光谱属性；
//      清零 voxelNetRads[].directTrad；随即 return（return 之后为保留的旧实现，不会执行）
//   3. （死代码）旧实现：对 TIR 波段按 Rli·direct·带宽×吸收率累加到 directTrad，
//      植被按太阳天顶余弦与 LAI 做修正
// 数据流：输入 voxelLinks、meshLinks、spectralMaterials、voxelDirs、atomConds、ubom.meteo；
//         输出 voxelNetRads[bufferId0].directTrad（当前恒为 0）
// 与其他文件的关系：与 voxelrad_diffuse_TIR_single.comp（实际承担 TIR 入射长波）配套；
//   include ../bindinglayout.h 等公共头；对应的短波版本为 voxelrad_direct_VNIR.comp
// 注意：return 之后的代码为不可达的旧实现（保留作参考，见 main 中 return 处的说明）。
// ==========================================================================

#version 460
#extension GL_ARB_separate_shader_objects : enable
#extension GL_EXT_nonuniform_qualifier : enable
#extension GL_GOOGLE_include_directive : enable
#extension GL_EXT_scalar_block_layout : enable
#extension GL_EXT_ray_tracing : enable
#extension GL_EXT_ray_query : enable
#extension GL_ARB_shader_clock : enable                 // Using clockARB
#extension GL_EXT_shader_image_load_formatted : enable  // The folowing extension allow to pass images as function parameters
#extension GL_NV_shader_sm_builtins : require     // Debug - gl_WarpIDNV, gl_SMIDNV
#extension GL_ARB_gpu_shader_int64 : enable       // Debug - heatmap value
#extension GL_EXT_shader_realtime_clock : enable  // Debug - heatmap timing
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_debug_printf : enable
#extension GL_KHR_memory_scope_semantics:require
#extension GL_EXT_shader_atomic_float: require 

#define VOXEL_LST_BIND_ININDEX
#define VOXELLST 1

#include "../bindinglayout.h"
#include "../parameters.h"
#include "../global.glsl"
#include "../functions.glsl"
#include "../nanovdb_info.glsl"
#include "../shade_state_voxel.glsl"

PtPayload        prd;
ShadowHitPayload shadow_payload;

#include "../traceray_comp.glsl"

layout(local_size_x = GROUP_SIZEX) in;

#define NUM_VNIR 2001 
#define NUM_BAND 2002

// 以下 MAXBAND/GammaR/GammaT 已于 2026-11-25 删除（本文件未引用，是从散射着色器拷贝来的遗留声明）。



// 模块：主入口，每线程处理一个体元（bufferId0）。
// 输入：体元索引与光谱材料；输出：voxelNetRads[bufferId0].directTrad（当前被清零后直接返回）。
void main()
{
    //------------------------------------------------------------
    // Initialization for the position and SSBO index
    //------------------------------------------------------------
    // get bufferId, voxelId, instanceId and typeId
    uint bufferId0 = uint(gl_GlobalInvocationID.x);
    if(bufferId0 >= uint(setting.voxelCount)) return;
    ivec3 voxelId0 = voxelLinks[bufferId0].voxelId;
    if(voxelLinks[bufferId0].isValid==0) return;
    // Get nanoVDBLink: from voxelId to bufferId
    NanoVDBLink nanoVDBLink = nanovdbInit();
    // uint bufferId = nanovdbGet(nanoVDBLink, voxelId0);
    uint instanceId = voxelLinks[bufferId0].instanceId;
    uint meshId = instanceLinks[instanceId].meshId;
    uint typeId = meshLinks[meshId].type;
    uint spectralId = meshLinks[meshId].spectralId;
    uint spectralIdBase = spectralId * NUM_BAND;

    int faceId = voxelLinks[bufferId0].faceId;
    // if(primId0 - faceid0*10 == 0) return; 
    uint canopyId = meshLinks[meshId].canopyId;
    // 步骤 1：清零直射 TIR 分量。
    voxelNetRads[bufferId0].directTrad = 0;

    // 步骤 2：提前返回。下面 return 之后直到文件末尾的整段旧实现是不可达的死代码，保留仅供参考：
    //   天空向下长波是半球均匀入射，已由 voxelrad_diffuse_TIR_single.comp 计入 diffuseTrad，
    //   这里若再按方向累加会把同一份天空通量算两次。directTrad 因此恒为 0（上一步清零）。
    // Rli is hemispherical downwelling longwave and is handled by diffuseTIR.
    // Keeping a directional component here would count the same sky flux twice.
    return;


    // 以下为旧实现（不可达）。Rin 为水平面入射短波、Rli 为天空向下长波（W m-2）；
    //   （2026-11-25 已改正行尾旧注释，原写成 measurement height / wind speed，与变量含义不符。）
    float Rin = ubom.meteo.Rin;               // 水平面入射短波 Rin（W m-2，旧实现未用）
    float Rli = ubom.meteo.Rli;               // 天空向下长波 Rli（W m-2）
    float cosSolar = abs(normalize(lightSet.direction).y);
    //---------------------------------------------------
    // Iteration in TIR band
    //---------------------------------------------------
    float alpha_toSolar = voxelDirs[bufferId0].solar; 
    // 步骤 3（旧实现）：遍历 TIR 波段；带宽由相邻波长差得到，
    // rad = Rli · atomConds.direct · 0.001 · 带宽（0.001 的单位换算待核对），再乘吸收率。
    for(int kband = NUM_VNIR; kband < NUM_BAND; kband++)
    {
        // solar direct radiance: lightSet.Rin*atomCondss[kband].direct*0.001
        // transmittance to solar: alpha_toSolar
        // absorb = 1- refl - trans
        float absorb = 1- spectralMaterials[spectralIdBase + kband].transmittance - 
                spectralMaterials[spectralIdBase + kband].reflectance;
        float band0 = atomConds[kband-1].wavelength;
        float bandwidth = atomConds[kband].wavelength - band0;
        float rad = Rli * atomConds[kband].direct * 0.001 * bandwidth;//  * absorb;

        // 植被：把水平面辐照按太阳天顶余弦折算到垂直入射面（cosSolar 下限 0.05 防止除零），
        // 再乘 0.5（随机叶向的一面受照）；变量 s、a 等为未使用的中间量。
        if (typeId == TYPE_VEGETATION){
            if (cosSolar > 0.05){ //
                rad = rad / cosSolar;
            }
            else{
                rad = rad / 0.05;
            }
            

            float lai = canopies[canopyId].lai;
            float p = calReCor(lai);
            float refl = spectralMaterials[spectralIdBase + kband].reflectance;
            float trans = spectralMaterials[spectralIdBase + kband].transmittance;
            float w = refl + trans;
            float s = (w - p* w) / (1 - p* w);
            float a = (1-w) / (1 - p *w); 
            // absorb = a;
            rad = rad * 0.5;
        }
        // else{
        //     rad = Rli * curDirect / effectWave * absorb;
        // }

        rad = rad * absorb;

        atomicAdd(voxelNetRads[bufferId0].directTrad,rad,
            gl_ScopeDevice,gl_StorageSemanticsBuffer,gl_SemanticsRelaxed);
    }

}