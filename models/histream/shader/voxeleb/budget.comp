#version 460
#extension GL_ARB_separate_shader_objects : enable
#extension GL_EXT_nonuniform_qualifier : enable
#extension GL_GOOGLE_include_directive : enable
#extension GL_EXT_scalar_block_layout : enable
#extension GL_EXT_ray_tracing : enable
#extension GL_EXT_ray_query : enable
#extension GL_ARB_shader_clock : enable                 // Using clockARB
#extension GL_EXT_shader_image_load_formatted : enable  // The folowing extension allow to pass images as function parameters

#extension GL_NV_shader_sm_builtins : require     // Debug - gl_WarpIDNV, gl_SMIDNV
#extension GL_ARB_gpu_shader_int64 : enable       // Debug - heatmap value
#extension GL_EXT_shader_realtime_clock : enable  // Debug - heatmap timing

#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_debug_printf : enable
#extension GL_KHR_memory_scope_semantics:require
#extension GL_EXT_shader_atomic_float: require 


#define VOXEL_LST_BIND_ININDEX
#define VOXELLST 

#include "../bindinglayout.h"
#include "../parameters.h"
#include "../global.glsl"
#include "../functions.glsl"
#include "../nanovdb_info.glsl"
#include "fluid_coupling.glsl"

#define NUM_VNIR 2001 
#define NUM_BAND 2002

layout(local_size_x = GROUP_SIZEX) in;

void main()
{
    //------------------------------------------------------------
    // Initialization for the position and SSBO index
    //------------------------------------------------------------
    uint bufferId = uint(gl_GlobalInvocationID.x);
    if(bufferId >= uint(setting.voxelCount)) return;
    if(voxelLinks[bufferId].isValid == 0) return;
    //voxelRes: voxel number in 3 dimentions
    ivec3 voxelRes = ivec3(setting.voxelSize);
    uint instanceId = voxelLinks[bufferId].instanceId;

    int faceId = voxelLinks[bufferId].faceId;
    //if(primId0 - faceid0*10 == 0) return; 

    //-------------------------
    // various parameters index
    //-------------------------
    // VoxelInstanceLink instanceLink = instanceLinks[instanceId];
    InstanceLink instanceLink = instanceLinks[instanceId];
    MeshLink meshLink = meshLinks[instanceLink.meshId];
    uint spectralId,canopyId,bioId,typeId;
    spectralId = meshLink.spectralId;
    canopyId = meshLink.canopyId;
    bioId = meshLink.bioId;
    typeId = meshLink.type;
    if(typeId == TYPE_NULL) return;
    Canopy mediumCanopy = canopies[canopyId];
    if(typeId == TYPE_VEGETATION && isParticipatingMedium(mediumCanopy)) {
        float fixedTemperature = mediumCanopy.fixedTemperature > 0.0
            ? mediumCanopy.fixedTemperature : ubom.meteo.Ta + 273.15;
        voxelTempes[bufferId].sunlit = fixedTemperature;
        voxelTempes[bufferId].shaded = fixedTemperature;
        voxelHeatFlux[bufferId].Hsunlit = 0.0;
        voxelHeatFlux[bufferId].Hshaded = 0.0;
        voxelHeatFlux[bufferId].LEsunlit = 0.0;
        voxelHeatFlux[bufferId].LEshaded = 0.0;
        voxelHeatFlux[bufferId].Gsunlit = 0.0;
        voxelHeatFlux[bufferId].Gshaded = 0.0;
        return;
    }
    //-------------------------
    // various parameters associated with radiation 
    //-------------------------
    // in: incident direct+diffuse VNIR+TIR radiance
    float inShadedRad = voxelNetRads[bufferId].diffuseVrad + voxelNetRads[bufferId].diffuseTrad;
    float inSunlitRad = inShadedRad + voxelNetRads[bufferId].directTrad + voxelNetRads[bufferId].directVrad;
    float TsunlitOld,TshadedOld;
    TsunlitOld = voxelTempes[bufferId].sunlit;
    TshadedOld = voxelTempes[bufferId].shaded;
    float Ta = localAirTemperatureC(bufferId);
    float fallbackSunlit = Ta + 2.0 + 273.15;
    float fallbackShaded = Ta + 1.0 + 273.15;
    if (isnan(TsunlitOld) || isinf(TsunlitOld)
        || TsunlitOld > TMAX_THRESHOLD || TsunlitOld < TMIN_THRESHOLD) {
        TsunlitOld = fallbackSunlit;
    }
    if (isnan(TshadedOld) || isinf(TshadedOld)
        || TshadedOld > TMAX_THRESHOLD || TshadedOld < TMIN_THRESHOLD) {
        TshadedOld = fallbackShaded;
    }
    // in: thermal emittance radiance 
    uint spectralBase = spectralId * NUM_BAND;
    float refl = spectralMaterials[spectralBase + NUM_VNIR].reflectance;
    float trans = spectralMaterials[spectralBase + NUM_VNIR].transmittance;
    float emis = clamp(1.0 - refl - trans, 0.0, 1.0);
    float outShadedRad;
    float outSunlitRad;
    // float outShadedRad = Stefen_Boltzmann(TshadedOld,emis);
    // float outSunlitRad = Stefen_Boltzmann(TsunlitOld,emis);
    //---------------------------------------------
    // Calculate net radiation for sunlit/shaded veg/soil
    //---------------------------------------------
    float netSunlitRad,netShadedRad;
    if(typeId == TYPE_VEGETATION)
    { 
        // float lai = canopies[canopyId].lai;
        // float p = calReCor(lai);
        // float w = refl + trans;
        // float s = (w - p* w) / (1 - p* w);
        // float a = (1-w) / (1 - p *w); 
        // emis = a;
        // A foliage element exchanges longwave radiation through both leaf
        // faces.  Voxel temperatures represent the whole leaf element, so
        // retain both emitting surfaces in its energy balance.
        outShadedRad = 2.0 * Stefen_Boltzmann(TshadedOld,emis);
        outSunlitRad = 2.0 * Stefen_Boltzmann(TsunlitOld,emis);
        // Diffuse shortwave and longwave are full-sphere totals absorbed by
        // both leaf faces; direct solar reaches only the illuminated face.
        netSunlitRad = inShadedRad +
            voxelNetRads[bufferId].directTrad +
            voxelNetRads[bufferId].directVrad - outSunlitRad;
        netShadedRad = inShadedRad - outShadedRad;
    }else if(typeId == TYPE_SOIL || typeId == TYPE_BUILDING || typeId == TYPE_WATER)
    {
        outShadedRad = Stefen_Boltzmann(TshadedOld,emis);
        outSunlitRad = Stefen_Boltzmann(TsunlitOld,emis);
        netSunlitRad = inSunlitRad - outSunlitRad;
        netShadedRad = inShadedRad - outShadedRad;
    }// IF TYPE

    // soil heat storage 
    float Gsunlit = voxelHeatFlux[bufferId].Gsunlit;
    float Gshaded = voxelHeatFlux[bufferId].Gshaded;
    if((typeId == TYPE_SOIL || typeId == TYPE_BUILDING) &&
       soilSets[bioId].method == 0)
    {
        Gsunlit = netSunlitRad * GST;
        Gshaded = netShadedRad * GST;
        voxelHeatFlux[bufferId].Gsunlit = Gsunlit;
        voxelHeatFlux[bufferId].Gshaded = Gshaded;
    }

    //-------------------------------------------------------
    //  Update surface temperature : old
    //-------------------------------------------------------
    // float Tsunlit,Tshaded;
    // float Ta = ubom.meteo.Ta;
    // float innovation1 = 0,innovation2 = 0;
    // float wc = 0.1;  // update coefficient 
    // // wc = 0.2;
    // float raa = voxelRaas[bufferId].raa ;
    // float diffHeatfluxSunlit =  voxelHeatFlux[bufferId].LEsunlit + Gsunlit;
    // float diffHeatfluxShaded =  voxelHeatFlux[bufferId].LEshaded + Gshaded;
    // innovation1 = raa/ (RHOA * CP) * (netSunlitRad - diffHeatfluxSunlit);
    // Tsunlit = ubom.meteo.Ta +273.15+  wc* innovation1 +(1-wc) * (TsunlitOld-273.15 - ubom.meteo.Ta);
    // innovation2 = raa / (RHOA * CP) * (netShadedRad - diffHeatfluxShaded);
    // Tshaded = ubom.meteo.Ta +273.15+ wc * innovation2 +(1-wc) * (TshadedOld-273.15 - ubom.meteo.Ta);
    // int count = 0;
    // if (abs(innovation1) > RAD_THRESHOLD) count = count + 1;
    // if( abs(innovation2) > RAD_THRESHOLD) count = count + 1;

    //-------------------------------------------------------
    //  Update surface temperature : new
    //-------------------------------------------------------
    float Tsunlit,Tshaded;
    float e_to_q = MH20 / MAIR / ubom.meteo.p;
    float TsunlitC = TsunlitOld - 273.15;
    float TshadedC = TshadedOld - 273.15;
    float ei_sunlit = es_fun(TsunlitC);
    float s_sunlit = s_fun(ei_sunlit, TsunlitC);
    float ei_shaded = es_fun(TshadedC);
    float s_shaded = s_fun(ei_shaded, TshadedC);
    float innovation1 = 0,innovation2 = 0;
    float raa = max(voxelRaas[bufferId].raa, 1.0);
    float rss_sunlit = voxelRsss[bufferId].sunlit;
    float rss_shaded = voxelRsss[bufferId].shaded;
    if(typeId == TYPE_VEGETATION)
    {
        // Per-face resistance, consistent with evapo.comp.
        rss_sunlit *= 2.0;
        rss_shaded *= 2.0;
    }
    float diffSunlitRad, diffShadedRad;
    // float diffSunlitRad = netSunlitRad - (voxelHeatFlux[bufferId].LEsunlit + Gsunlit + voxelHeatFlux[bufferId].Hsunlit);
    // float diffShadedRad = netShadedRad - (voxelHeatFlux[bufferId].LEshaded + Gshaded + voxelHeatFlux[bufferId].Hshaded);
    float lambdas_sunlit = (2.501 - 0.002361 * TsunlitC) * 1E6;
    float lambdas_shaded = (2.501 - 0.002361 * TshadedC) * 1E6;
    float wc = 0.2;
    float sensibleDerivative = (RHOA * CP) / raa;
    float latentDerivativeSunlit = RHOA * lambdas_sunlit * e_to_q *
        max(s_sunlit, 0.0) / max(raa + max(rss_sunlit, 0.0), 1.0);
    float latentDerivativeShaded = RHOA * lambdas_shaded * e_to_q *
        max(s_shaded, 0.0) / max(raa + max(rss_shaded, 0.0), 1.0);
    if(typeId == TYPE_BUILDING ||
       (typeId == TYPE_SOIL &&
        localSoilMoisture(bufferId, bioId) < 0.03))
    {
        latentDerivativeSunlit = 0.0;
        latentDerivativeShaded = 0.0;
    }
    if(typeId == TYPE_WATER)
    {
        float evaporationCoefficient = clamp(
            waterSets[bioId].evaporationCoefficient, 0.0, 1.0);
        latentDerivativeSunlit *= evaporationCoefficient;
        latentDerivativeShaded *= evaporationCoefficient;
    }
    float storageDerivative = 0.0;
    float radiativeScale = 1.0;
    if(typeId == TYPE_SOIL || typeId == TYPE_BUILDING)
    {
        if(soilSets[bioId].method == 0)
        {
            radiativeScale = 1.0 - GST;
        }
        else if(soilSets[bioId].method == 1)
        {
            float inertia = thermal_inertial(
                soilSets[bioId].cs, soilSets[bioId].rhos,
                soilSets[bioId].lambdas);
            storageDerivative = 2.0 * inertia /
                sqrt(PI * max(ubom.meteo.dtime, 1.0));
        }
        else
        {
            float Mprofile[TLASTNUM];
            for(int kdepth = 0; kdepth < TLASTNUM; ++kdepth)
                Mprofile[kdepth] = soilMoistureFraction(
                    localSoilMoisture(bufferId, bioId), soilSets[bioId].SatWater);
            storageDerivative = soilHeatFluxSurfaceDerivative(
                Mprofile, ubom.meteo.dtime, soilSets[bioId].cs,
                soilSets[bioId].rhos, soilSets[bioId].lambdas,
                soilSets[bioId].SatWater);
        }
    }
    // if(setting.theIteration>5) wc = 0.3;
    // if(setting.theIteration>10) wc = 0.2;
    // if(setting.theIteration>30) wc = 0.1;
    // Tsunlit = TsunlitOld + diffSunlitRad * wc / ((RHOA*CP)/raa+
    //     RHOA*lambdas_sunlit*e_to_q*s_sunlit/(raa+rss_sunlit)+4*SIGMASB*pow(TsunlitOld,3));
    // Tshaded = TshadedOld + diffShadedRad * wc / ((RHOA*CP)/raa+
    //     RHOA*lambdas_shaded*e_to_q*s_shaded/(raa+rss_shaded)+4*SIGMASB*pow(TshadedOld,3));
    //    分母第二项太大了，导致温度修正量很小很小
    // 暂时先用下列近似情况
    // Tsunlit = TsunlitOld + diffSunlitRad * wc / ((RHOA*CP)/raa + (RHOA*CP)/raa + 4*SIGMASB*pow(TsunlitOld,3));
    // Tshaded = TshadedOld + diffShadedRad * wc / ((RHOA*CP)/raa + (RHOA*CP)/raa + 4*SIGMASB*pow(TshadedOld,3));
    // Tsunlit = TsunlitOld + diffSunlitRad * wc / ((RHOA*CP)/raa + 4*SIGMASB*pow(TsunlitOld,3));
    // Tshaded = TshadedOld + diffShadedRad * wc / ((RHOA*CP)/raa + 4*SIGMASB*pow(TshadedOld,3));
    if(typeId == TYPE_VEGETATION)
    { 
        // Sensible and latent exchange also occur on both leaf faces.  Soil
        // storage is not part of the leaf energy balance.
        diffSunlitRad = netSunlitRad - 2.0 *
            (voxelHeatFlux[bufferId].LEsunlit +
             voxelHeatFlux[bufferId].Hsunlit);
        diffShadedRad = netShadedRad - 2.0 *
            (voxelHeatFlux[bufferId].LEshaded +
             voxelHeatFlux[bufferId].Hshaded);
        float denominatorSunlit = 8.0 * emis * SIGMASB *
            pow(TsunlitOld, 3.0) + 2.0 * sensibleDerivative +
            2.0 * latentDerivativeSunlit;
        float denominatorShaded = 8.0 * emis * SIGMASB *
            pow(TshadedOld, 3.0) + 2.0 * sensibleDerivative +
            2.0 * latentDerivativeShaded;
        Tsunlit = TsunlitOld + wc * diffSunlitRad / max(denominatorSunlit, 1.0);
        Tshaded = TshadedOld + wc * diffShadedRad / max(denominatorShaded, 1.0);
    }else if(typeId == TYPE_WATER)
    {
        float sunlitFraction = clamp(voxelDirs[bufferId].solar, 0.0, 1.0);
        float TwaterOld = mix(TshadedOld, TsunlitOld, sunlitFraction);
        float netWaterRad = mix(netShadedRad, netSunlitRad, sunlitFraction);
        float Hwater = mix(voxelHeatFlux[bufferId].Hshaded,
                           voxelHeatFlux[bufferId].Hsunlit, sunlitFraction);
        float LEwater = mix(voxelHeatFlux[bufferId].LEshaded,
                            voxelHeatFlux[bufferId].LEsunlit, sunlitFraction);
        float Qwater = mix(Gshaded, Gsunlit, sunlitFraction);
        // Open-water balance: Rn = H + LE + Qw.
        float waterResidual = netWaterRad - Hwater - LEwater - Qwater;
        float storageRate = max(
            waterSets[bioId].heatCapacity * max(waterSets[bioId].mixingDepth, 0.01)
            / max(ubom.meteo.dtime, 1.0), 1.0);
        float latentDerivativeWater = mix(
            latentDerivativeShaded, latentDerivativeSunlit, sunlitFraction);
        float denominator = storageRate + sensibleDerivative +
                            latentDerivativeWater +
                            4.0 * emis * SIGMASB * pow(TwaterOld, 3.0);
        float Twater = TwaterOld + wc * waterResidual / denominator;
        Tsunlit = Twater;
        Tshaded = Twater;
        diffSunlitRad = waterResidual;
        diffShadedRad = waterResidual;
    }else if(typeId == TYPE_SOIL || typeId == TYPE_BUILDING)
    {
        diffSunlitRad = netSunlitRad - (voxelHeatFlux[bufferId].LEsunlit + Gsunlit + voxelHeatFlux[bufferId].Hsunlit);
        diffShadedRad = netShadedRad - (voxelHeatFlux[bufferId].LEshaded + Gshaded + voxelHeatFlux[bufferId].Hshaded);
        float denominatorSunlit = radiativeScale * 4.0 * emis * SIGMASB *
            pow(TsunlitOld, 3.0) + sensibleDerivative +
            latentDerivativeSunlit + storageDerivative;
        float denominatorShaded = radiativeScale * 4.0 * emis * SIGMASB *
            pow(TshadedOld, 3.0) + sensibleDerivative +
            latentDerivativeShaded + storageDerivative;
        Tsunlit = TsunlitOld + wc * diffSunlitRad /
            max(denominatorSunlit, 1.0);
        Tshaded = TshadedOld + wc * diffShadedRad /
            max(denominatorShaded, 1.0);
    }// IF TYPE
    // Non-finite residuals are never converged.
    int count = int(isnan(diffSunlitRad) || isinf(diffSunlitRad) ||
                    abs(diffSunlitRad) > RAD_THRESHOLD) +
                int(isnan(diffShadedRad) || isinf(diffShadedRad) ||
                    abs(diffShadedRad) > RAD_THRESHOLD);

    if(setting.energyFinalize != 0)
    {
        // All input fluxes now use the exported temperatures. Retain these
        // temperatures and assess closure independently of the last update.
        atomicAdd(ebState.count,count,gl_ScopeDevice,gl_StorageSemanticsBuffer,gl_SemanticsRelaxed);
        return;
    }



    //-----------------------------------------
    // adjust bad temperature 
    //-----------------------------------------
    if (isnan(Tsunlit) || isinf(Tsunlit)) Tsunlit = TsunlitOld;
    if (isnan(Tshaded) || isinf(Tshaded)) Tshaded = TshadedOld;
    Tsunlit = clamp(Tsunlit, float(TMIN_THRESHOLD), float(TMAX_THRESHOLD));
    Tshaded = clamp(Tshaded, float(TMIN_THRESHOLD), float(TMAX_THRESHOLD));


    //-------------------------------------------
    // SAVE BACK
    //------------------------------------------- 

    
    voxelTempes[bufferId].sunlit = Tsunlit;
    voxelTempes[bufferId].shaded = Tshaded;
    atomicAdd(ebState.count,count,gl_ScopeDevice,gl_StorageSemanticsBuffer,gl_SemanticsRelaxed);


}
