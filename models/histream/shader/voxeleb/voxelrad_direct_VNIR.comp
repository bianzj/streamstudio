#version 460
#extension GL_ARB_separate_shader_objects : enable
#extension GL_EXT_nonuniform_qualifier : enable
#extension GL_GOOGLE_include_directive : enable
#extension GL_EXT_scalar_block_layout : enable
#extension GL_EXT_ray_tracing : enable
#extension GL_EXT_ray_query : enable
#extension GL_ARB_shader_clock : enable                 // Using clockARB
#extension GL_EXT_shader_image_load_formatted : enable  // The folowing extension allow to pass images as function parameters
#extension GL_NV_shader_sm_builtins : require     // Debug - gl_WarpIDNV, gl_SMIDNV
#extension GL_ARB_gpu_shader_int64 : enable       // Debug - heatmap value
#extension GL_EXT_shader_realtime_clock : enable  // Debug - heatmap timing
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_debug_printf : enable
#extension GL_KHR_memory_scope_semantics:require
#extension GL_EXT_shader_atomic_float: require 

#define VOXEL_LST_BIND_ININDEX
#define VOXELLST 1

#include "../bindinglayout.h"
#include "../parameters.h"
#include "../global.glsl"
#include "../functions.glsl"
#include "../nanovdb_info.glsl"
#include "../shade_state_voxel.glsl"

PtPayload        prd;
ShadowHitPayload shadow_payload;

#include "../traceray_comp.glsl"

layout(local_size_x = GROUP_SIZEX) in;

#define MAXBAND    25
#define NUM_VNIR 2001 
#define NUM_BAND 2002

float GammaR[DIFFUSE_ANGLE_NUM * DIFFUSE_ANGLE_NUM];
float GammaT[DIFFUSE_ANGLE_NUM * DIFFUSE_ANGLE_NUM];



void main()
{
    //------------------------------------------------------------
    // Initialization for the position and SSBO index
    //------------------------------------------------------------
    // get bufferId, voxelId, instanceId and typeId
    uint bufferId0 = uint(gl_GlobalInvocationID.x);
    if(bufferId0 >= uint(setting.voxelCount)) return;
    ivec3 voxelId0 = voxelLinks[bufferId0].voxelId;
    if(voxelLinks[bufferId0].isValid==0) return;
    // Get nanoVDBLink: from voxelId to bufferId
    NanoVDBLink nanoVDBLink = nanovdbInit();
    uint instanceId = voxelLinks[bufferId0].instanceId;
    uint meshId = instanceLinks[instanceId].meshId;
    uint typeId = meshLinks[meshId].type;
    uint spectralId = meshLinks[meshId].spectralId;
    uint spectralIdBase = spectralId * NUM_BAND;
    uint canopyId = meshLinks[meshId].canopyId;
    Canopy canopy = canopies[canopyId];
    voxelNetRads[bufferId0].directVrad = 0.0;
    voxelPnets[bufferId0].directPnet = 0.0;

    //---------------------------------------------------
    // Iteration in VNIR band
    //---------------------------------------------------
    float Rin = ubom.meteo.Rin;               // measurement height 
    float Rli = ubom.meteo.Rli;               // wind speed

    vec3 solarDirection = normalize(lightSet.direction);
    float cosSolar = abs(solarDirection.y);
    float alpha_toSolar = voxelDirs[bufferId0].solar;
    // Sunlit/shaded temperatures are conditional components.  Always solve
    // the sunlit component with unobstructed direct irradiance; voxelDirs.solar
    // is applied later as the moving sunlit fraction. Gating the direct term
    // with alpha_toSolar makes both conditional temperatures shaded exactly
    // under a crown and erases the shadow.
    if(solarDirection.y <= 0.01) return;

    // Rin*direct is horizontal irradiance. Convert it to the irradiance on the
    // absorbing element: G/cos(sza) per one-sided leaf area for foliage,
    // cos(incidence)/cos(sza) for a solid facet.
    float projection = 1.0;
    bool medium = isParticipatingMedium(canopy);
    if(typeId == TYPE_VEGETATION && !medium) {
        projection = max(canopy.G, 0.0) / max(cosSolar, 0.05);
    } else if(medium) {
        projection = alpha_toSolar / max(cosSolar, 0.05);
    } else {
        projection = max(dot(solidSurfaceNormal(int(bufferId0)), solarDirection), 0.0)
            / cosSolar;
    }
    float mediumAbsorption = medium
        ? (1.0 - canopyVoxelTransmittance(canopy, 0.0, 0.0, 1.0, setting.scale))
            * (1.0 - clamp(canopy.scatteringAlbedo, 0.0, 1.0))
        : 0.0;

    float absorbed = 0.0;
    float absorbedPar = 0.0;
    for(int kband = 0; kband < NUM_VNIR; ++kband)
    {
        SpectralMaterial material = spectralMaterials[spectralIdBase + kband];
        float absorb = medium ? mediumAbsorption
            : 1.0 - material.reflectance - material.transmittance;
        float rad = Rin * atomConds[kband].direct * 0.001 * projection * absorb;
        absorbed += rad;
        float wavelength = atomConds[kband].wavelength;
        if(wavelength >= 400.0 && wavelength <= 700.0)
            absorbedPar += absorbedParPhotonFlux(rad, wavelength);
    }
    voxelNetRads[bufferId0].directVrad = absorbed;
    voxelPnets[bufferId0].directPnet = absorbedPar;
}
