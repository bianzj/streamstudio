// 调试辅助：读取第 loc 个体元的 AABB（aabbs 缓冲）。本文件内未被调用。
AllAabb LookUpAABB(int loc)
{
	AllAabb aabb = aabbs[loc];
	return aabb;
}

// 调试辅助：按整数体元坐标查询 NanoVDB，返回其值（缓冲下标，空体元为 -1，初值 -10000 仅作占位）。
//   本文件内未被调用。
float LookUpNanoValue(ivec3 pos)
{
	float value = -10000;
	NanoVDBLink nanoVDBLink = nanovdbInit();
	value = nanovdbGet(nanoVDBLink,pos);
	return value;
}

// 作用：每个工作项处理一个体元：求到太阳的透过率，并清零漫射辐射缓冲。
// 步骤：1 读取体元索引/实例/类型并求体元中心；2 沿太阳方向调用 traversalDirection；
//       3 把本体元所有 (波段, 方向) 的 cumulated 与 induced 清零。
void main()
{
    //------------------------------------------------------------
    // Initialization for the position and SSBO index
    //------------------------------------------------------------
    // get bufferId, voxelId, instanceId and typeId
    uint bufferId0 = uint(gl_GlobalInvocationID.x);
    ivec3 voxelId0 = voxelLinks[bufferId0].voxelId;
    uint instanceId0 = voxelLinks[bufferId0].instanceId;
    uint typeId0 = instanceLinks[instanceId0].type;
    // Get nanoVDBLink: from voxelId to bufferId
    NanoVDBLink nanoVDBLink = nanovdbInit();

    // get center position of a voxel
    float scale = settingxml.scale;
    vec3 semiRange = settingxml.scale * settingxml.voxelSize/2.0;
    vec3 voxelPos0 = vec3((voxelId0.x)*scale-semiRange.x, (voxelId0.y)*scale,(voxelId0.z)*scale-semiRange.z ); 
    if(typeId0 == TYPE_SOIL)
    {
        voxelPos0 = vec3((voxelId0.x+1)*scale - semiRange.x, (voxelId0.y)*scale,(voxelId0.z+1)*scale-semiRange.z ); 
    }

    // solar direction.
    // 太阳方向（lightSet.direction 为指向太阳的世界坐标方向，由 offline.rgen 中“向太阳发阴影光线”可推知）。
    vec3 directions = normalize(lightSet.direction);
    
    // calculate the transmittance from voxel to solar.
    // 步骤 2：求体元到太阳的透过率；结果通过 voxelDirs[bufferId0].solar 写出，返回值未使用。
    traversalDirection(directions);

    // 步骤 3：清零。induced 为本轮入射辐射，cumulated 为多次散射累积量；后续漫射迭代以它们为起点。
    // initialize induced and cumulated, both are set 0.
    for(int kband=0;kband<settingxml.maxBand;kband++)
    {
