// calculate the transmittance from voxel to solar
// To check the access of a voxel to a long distance along a direction
bool traversalDirection(vec3 direction)
{
    //////////////////////////////////////////////
    // This is a original position and direction
    //////////////////////////////////////////////
    uint bufferId0 = uint(gl_GlobalInvocationID.x);     // 当前的体素处理单元index
    ivec3 voxelId0 = voxelLinks[bufferId0].voxelId;     // 当前体素处理单元的空间位置坐标（int类型）
    uint instanceId0 = voxelLinks[bufferId0].instanceId;// 当前体素处理单元的instance index
    uint typeId0 = instanceLinks[instanceId0].type;     // 当前体素所属的地物类型
    // Get nanoVDBLink: from voxelId to bufferId
    NanoVDBLink nanoVDBLink = nanovdbInit();            // 得到 nano VDB 存储的数据集，其内部存储voxelLinks的index，可以通过空间位置查询其所属位置的属性和地物类型

    float scale = settingxml.scale;
    vec3 semiRange = scale * settingxml.voxelSize/2.0;
    ivec3 voxelId,alignVoxelId;
    float alpha_toSolar = 1.0,alpha_voxel = 1.0;
    int bufferId,alignBufferId;
    uint instanceId, alignInstanceId,canopyId,lastInstanceId,typeId;
    VoxelInstanceLink instanceLink;
    Canopy canopy;
    float shortDistance = SHORTDISTANCE*scale;
    // the center position of a voxel 
    vec3 voxelPos0 =  vec3((voxelId0.x)*scale-semiRange.x, (voxelId0.y)*scale,(voxelId0.z)*scale-semiRange.z ); 
    // if type is soil, the position is located at bottom facet center.
    if(typeId0 == TYPE_SOIL)
    {
        voxelPos0 =  vec3((voxelId0.x+1)*scale-semiRange.x, (voxelId0.y)*scale,(voxelId0.z+1)*scale-semiRange.z ); 
    }

    // ray cast from the center position of a voxel along a specific direction
    Ray originalRay = Ray(voxelPos0, normalize(direction));
    Ray ray = originalRay;

    // This is a process toward direction step by step 
    int kstep = 0;
    vec3 ffnormal;
  for(kstep = 0;kstep<settingxml.maxStep;kstep++)
  {
    // the transmittance inside a voxel 
    alpha_voxel = 1.0;
    // avoid hit itself for the original voxel
    // ClosestHit(ray, shortDistance);
    ClosestHit(ray);
    if(prd.hitT == INFINITY)
    {
      // hit nothing and return 
      voxelDirs[bufferId0].solar = alpha_toSolar; 
      return false;
    }

    // // get hit information
    // ShadeState sstate = GetShadeState(prd);
    vec3 hitPos = ray.origin + ray.direction * prd.hitT;
    voxelId = getVoxelId(hitPos, semiRange, settingxml.scale, normalize(direction));


