  //     // get bufferId and alignBufferId;
  //     // if bufferId/alignBufferId = -1, this voxel is blank;
  //     bufferId = nanovdbGet(nanoVDBLink,voxelId);
  //     alignBufferId = nanovdbGet(nanoVDBLink,alignVoxelId);
      
  //     if(kstep == 0) {lastInstanceId = instanceId0; alignInstanceId = instanceId0;}
  //     if(bufferId >= 0)
  //     {
  //       // a valid voxel and get voxel information 
  //       // such as instanceId, typeId, spectralId, thermalId, canopyId
  //       instanceId = bufferVoxelLinks[bufferId].instanceId;
  //       instanceLink = instanceLinks[instanceId];
  //       canopyId = instanceLink.canopyId;
  //       typeId = instanceLink.typeId;
  //       // if(typeId == TYPE_SOIL) continue;
  //       // the condition (instanceId == lastInstanceId) for path from penetrating part 
  //       // the condition (instanceId == alignInstanceId) due to a face corresponding to two facets belong to two align voxels, respectively
  //       // if((alignInstanceId == lastInstanceId || instanceId == alignInstanceId))
  //       // {
  //       //   // get the pathLength from 
  //         float pathLength = Vector2Distance(sstate.position - sstate.lastPosition);
  //         canopy = canopies[canopyId];
  //         alpha_voxel = exp(-canopy.density * canopy.G * pathLength);
  //       // }
  //     }
  //     alpha_toSolar = alpha_voxel * alpha_toSolar;
  //   }
  //   else
  //   {
  //     // if it hit itself in the firest ray cast, continue 
  //     // length check
  //     if(kstep == 0  && sstate.instanceId == instanceId0)
  //     {
  //       continue;
