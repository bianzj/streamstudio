AllAabb LookUpAABB(int loc)
{
	AllAabb aabb = aabbs[loc];
	return aabb;
}

float LookUpNanoValue(ivec3 pos)
{
	float value = -10000;
	NanoVDBLink nanoVDBLink = nanovdbInit();
	value = nanovdbGet(nanoVDBLink,pos);
	return value;
}

