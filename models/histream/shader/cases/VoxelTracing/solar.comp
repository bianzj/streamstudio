// MAXSTEP 在本文件未使用（实际步数上限取 settingxml.maxStep）；DIFFUSE_ANGLE_NUM 为
// 半球漫射离散方向数；MAXBAND 为最大波段数；NUM_VNIR/NUM_BAND/NUM_TIR 为高光谱波段数
// （可见-近红外 2001 + 热红外 162 = 2163，与 NUM_BAND = 2162 不一致，待核对），本文件未使用。
#define MAXSTEP   100
#define DIFFUSE_ANGLE_NUM 32
#define MAXBAND    25
#define NUM_VNIR 2001 // number of VNIR bands
#define NUM_BAND 2162 // number of VNIR+TIR bands
#define NUM_TIR 162  // number of TIR bands

// 作用：从当前体元中心出发沿 direction（太阳方向）射线穿越场景，估计到太阳的透过率。
// 输入：direction 世界坐标的指向太阳的方向（本函数内部归一化）；
// 输出：返回 false 表示射线射出场景（此时 voxelDirs[bufferId0].solar = alpha_toSolar 并返回）；
//   其余路径返回 true（逐体元累计透过率的实现已被注释，solar 不会被写入）。
// 副作用：写 voxelDirs[bufferId0].solar；修改全局 prd。
// calculate the transmittance from voxel to solar
// To check the access of a voxel to a long distance along a direction
bool traversalDirection(vec3 direction)
{
    //////////////////////////////////////////////
    // This is a original position and direction
    //////////////////////////////////////////////
    uint bufferId0 = uint(gl_GlobalInvocationID.x);     // 当前的体素处理单元index
    ivec3 voxelId0 = voxelLinks[bufferId0].voxelId;     // 当前体素处理单元的空间位置坐标（int类型）
    uint instanceId0 = voxelLinks[bufferId0].instanceId;// 当前体素处理单元的instance index
    uint typeId0 = instanceLinks[instanceId0].type;     // 当前体素所属的地物类型
    // Get nanoVDBLink: from voxelId to bufferId
    NanoVDBLink nanoVDBLink = nanovdbInit();            // 得到 nano VDB 存储的数据集，其内部存储voxelLinks的index，可以通过空间位置查询其所属位置的属性和地物类型

    float scale = settingxml.scale;
    vec3 semiRange = scale * settingxml.voxelSize/2.0;
    ivec3 voxelId,alignVoxelId;
    float alpha_toSolar = 1.0,alpha_voxel = 1.0;
    int bufferId,alignBufferId;
    uint instanceId, alignInstanceId,canopyId,lastInstanceId,typeId;
    VoxelInstanceLink instanceLink;
    Canopy canopy;
    // 避免自相交的最小距离（以体元尺寸缩放）；目前使用它的 ClosestHit(ray, shortDistance) 已被注释。
    float shortDistance = SHORTDISTANCE*scale;
    // 步骤 1：确定射线起点。普通体元取体元中心位置（x、z 以 scale 为单位并减去 semiRange 居中）；
    //   土壤体元起点放在其底面中心（x、z 各加一格偏移，待核对）。
    // the center position of a voxel 
    vec3 voxelPos0 =  vec3((voxelId0.x)*scale-semiRange.x, (voxelId0.y)*scale,(voxelId0.z)*scale-semiRange.z ); 
    // if type is soil, the position is located at bottom facet center.
    if(typeId0 == TYPE_SOIL)
    {
        voxelPos0 =  vec3((voxelId0.x+1)*scale-semiRange.x, (voxelId0.y)*scale,(voxelId0.z+1)*scale-semiRange.z ); 
    }

    // ray cast from the center position of a voxel along a specific direction
    Ray originalRay = Ray(voxelPos0, normalize(direction));
    Ray ray = originalRay;

    // This is a process toward direction step by step 
    int kstep = 0;
    vec3 ffnormal;
  // 步骤 2：逐步前进的主循环，最多 settingxml.maxStep 步。
  //   有效代码只剩“求最近交点、未命中则写 solar 并返回”，之后的命中处理均被注释。
  for(kstep = 0;kstep<settingxml.maxStep;kstep++)
  {
    // the transmittance inside a voxel 
    alpha_voxel = 1.0;
    // avoid hit itself for the original voxel
    // ClosestHit(ray, shortDistance);
    // 求最近交点；hitT == INFINITY 表示射线射出场景（看到太阳），透过率保持 alpha_toSolar = 1。
    ClosestHit(ray);
    if(prd.hitT == INFINITY)
    {
      // hit nothing and return 
      voxelDirs[bufferId0].solar = alpha_toSolar; 
      return false;
    }

    // // get hit information
    // ShadeState sstate = GetShadeState(prd);
    vec3 hitPos = ray.origin + ray.direction * prd.hitT;
    // 由命中点换算所在体元的整数索引 voxelId（沿射线方向取整，避免落在体元边界）；
    //   当前 voxelId 之后没有被使用（后续处理已被注释）。
    voxelId = getVoxelId(hitPos, semiRange, settingxml.scale, normalize(direction));


  //   // voxel object
  //   if(sstate.typeId == TYPE_VEGETATION)
  //   {
  //     // get voxelId and alignVoxelId
  //     voxelId = getVoxelIdSemi(sstate.position, semiRange, settingxml.scale, normalize(direction), alignVoxelId);
  //     // get bufferId and alignBufferId;
  //     // if bufferId/alignBufferId = -1, this voxel is blank;
  //     bufferId = nanovdbGet(nanoVDBLink,voxelId);
  //     alignBufferId = nanovdbGet(nanoVDBLink,alignVoxelId);
      
  //     if(kstep == 0) {lastInstanceId = instanceId0; alignInstanceId = instanceId0;}
  //     if(bufferId >= 0)
  //     {
  //       // a valid voxel and get voxel information 
  //       // such as instanceId, typeId, spectralId, thermalId, canopyId
  //       instanceId = bufferVoxelLinks[bufferId].instanceId;
  //       instanceLink = instanceLinks[instanceId];
  //       canopyId = instanceLink.canopyId;
  //       typeId = instanceLink.typeId;
  //       // if(typeId == TYPE_SOIL) continue;
  //       // the condition (instanceId == lastInstanceId) for path from penetrating part 
  //       // the condition (instanceId == alignInstanceId) due to a face corresponding to two facets belong to two align voxels, respectively
  //       // if((alignInstanceId == lastInstanceId || instanceId == alignInstanceId))
  //       // {
  //       //   // get the pathLength from 
  //         float pathLength = Vector2Distance(sstate.position - sstate.lastPosition);
  //         canopy = canopies[canopyId];
  //         alpha_voxel = exp(-canopy.density * canopy.G * pathLength);
  //       // }
  //     }
  //     alpha_toSolar = alpha_voxel * alpha_toSolar;
  //   }
  //   else
  //   {
  //     // if it hit itself in the firest ray cast, continue 
  //     // length check
  //     if(kstep == 0  && sstate.instanceId == instanceId0)
  //     {
  //       continue;
  //     } else
  //     {
  //       alpha_toSolar = 0;
  //       break;
  //     }
  //   }
  //   // a threshold to stop 
  //   if(alpha_toSolar <= 0.01) break; 
  //   // prepare for the next ray cast
  //   ray = Ray(sstate.position,direction);
  //   ffnormal  = sstate.normal;
  //   ray.origin = OffsetRay(ray.origin, dot(ray.direction, ffnormal) > 0 ? ffnormal : -ffnormal);
  // }

  // voxelDirs[bufferId0].solar = alpha_toSolar; 
  return true;
}

