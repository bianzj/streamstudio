bool TraversalDirection(vec3 lightDirection)
{
    //------------------------------------------------------------
    // Initialization for the position and SSBO index
    //------------------------------------------------------------
    // get bufferId, voxelId, instanceId and typeId
    uint bufferId0 = uint(gl_GlobalInvocationID.x);
    ivec3 voxelId0 = voxelLinks[bufferId0].voxelId;
    // uint instanceId0 = voxelLinks[bufferId0].instanceId;
    // uint typeId0 = instanceLinks[instanceId0].type;
    // Get nanoVDBLink: from voxelId to bufferId
    NanoVDBLink nanoVDBLink = nanovdbInit();

    // get center position of a voxel
    float scale = settingxml.scale;
    vec3 semiRange = settingxml.scale * settingxml.voxelSize/2.0;
    vec3 voxelPos0 = vec3(voxelId0.x + scale/2.0, voxelId0.y + scale/2.0, voxelId0.z + scale/2.0);

    ivec3 voxelId;                      // current passed voxel
    int bufferId;                       // passed voxel Id
    uint instanceId, canopyId, typeId;  //passed voxel Id through voxelLink and instanceLink.
    float alpha_toSolar = 1.0;
    float alpha_voxel = 1.0;
    
    // ray cast from the center position of a voxel along a specific direction
    Ray ray = Ray(voxelPos0, normalize(lightDirection));

    // This is a process toward direction step by step
    int kstep = 0;
    vec3 ffnormal;
    for(kstep = 0; kstep<settingxml.maxStep; kstep++)
    {
        // the transmittance inside a voxel
        alpha_voxel = 1.0;

        ClosestHit(ray);
        // hit nothing and return false.
        if(prd.hitT == INFINITY)
        {
            voxelDirs[bufferId0].solar = alpha_toSolar;
            return false;
        }

        // get hit information, especially get ffnormal to avoid hit self.
        ShadeState sstate = GetShadeState(prd);
        voxelId = getPassedVoxelId(sstate.position, scale, normalize(lightDirection));
        bufferId = nanovdbGet(nanoVDBLink, voxelId);
        
        // a valid voxel and get this voxel information.
        if(bufferId >= 0)
        {
            instanceId = voxelLinks[bufferId].instanceId;
            typeId = instanceLinks[instanceId].type;
            canopyId = instanceLinks[instanceId].canopyId;
            // if soil, this voxel transmittance is 1.
            if(typeId == TYPE_SOIL)
            {
                if(kstep == 0)  alpha_voxel = 1;
                else 
                {
                    alpha_toSolar = 0.0;
                    break;
                }
            }
            if(typeId == TYPE_VEGETATION)
            {
                float pathLength = Vector2Distance(sstate.position - sstate.lastPosition);
                alpha_voxel = exp(-canopies[canopyId].density * canopies[canopyId].G * pathLength);
            }
        }
        alpha_toSolar = alpha_toSolar * alpha_voxel;

        if(alpha_toSolar <= 0.01) break;
        // avoid hit self.
        ffnormal  = sstate.normal;
        ray.origin = OffsetRay(sstate.position, dot(ray.direction, ffnormal) > 0 ? ffnormal : -ffnormal);
    }

    voxelDirs[bufferId0].solar = alpha_toSolar;

    return true;
}

// It is used for single scattering term. solar term.
bool Voxel_raytracing_diffuse_single(vec3 voxelPos0, uint bufferId0, NanoVDBLink nanoVDBLink)
{
    /// induced direction for the voxel; 0 is not normalized direction.
    vec3 directioni, directioni0;
    /// scattering direction cosine value
    float cosThetai; 
    /// the ray along scattering direction.
    Ray ray;
    /// transmittance from voxel to solar; from voxel to current voxel; current voxel
    float alpha_toSolar, alpha_toVoxel, alpha_voxel;
    ivec3 voxelId;                          // current passed voxel
    int bufferId;                           // passed voxel Id
    float scale = settingxml.scale;
    uint instanceId, typeId;                // passed voxel Id through voxelLink and instanceLink.
    uint canopyId, thermalId, spectralId;   // passed voxel spectral, thermal, canopy ID.
    vec3 ffnormal;                          // Collision Point Normals
    Canopy canopy;
    float pl_toSolar, pl_toVoxel;

    for(int iangle = 0; iangle < DIFFUSE_ANGLE_NUM; iangle++)
    {
        directioni0 = DIFFUSE_DIRECTIONS[iangle];
        directioni = normalize(directioni0);
        cosThetai = CosThetaTangent(directioni);

        // launch a ray along this scattering direction.
        ray = Ray(voxelPos0, directioni);

        alpha_toSolar = 1.0;
        alpha_toVoxel = 1.0;

        ////// interation in travel step //////
        for(int kstep = 0; kstep < settingxml.maxStep; kstep++)
        {
            alpha_voxel = 1.0;
            ClosestHit(ray);

            // avoid itself
            if(kstep == 0) 
            {
                ShadeState sstate = GetShadeState(prd);
                ray = Ray(sstate.position, directioni);
                ffnormal = sstate.normal;
                ray.origin = OffsetRay(ray.origin, dot(ray.direction, ffnormal) > 0 ? ffnormal : -ffnormal);
                continue;
            }
            ///////////////////////////////////////////////////
            /// sky case (sky -> i).
            /// sky only exists in the upper hemisphere space. 
            /// so the direction number is N/2.
            ///////////////////////////////////////////////////
            if(prd.hitT == INFINITY)
            {
                for(int kband = 0; kband < sensorMatrix.waveNum; kband++)
                {
                    float radiance = 0.0;
                    /// induced from upper hemisphere.
                    if(ray.direction.y > 0)
                    {
                        if(settingxml.isTemperature == 1)
                        {
                            int waveInd = sensorWaveInds[kband].value;
                            float wavelength = waveSets[waveInd].wavelength;
                            if(wavelength > 50) wavelength = wavelength/1000.0;
                            if(wavelength > 2.5)
                            {
                                radiance += Planck(wavelength, lightSet.skyTemperature) * alpha_toVoxel;
                            }
                            else
                            {
                                radiance += lightSet.diffuse / (DIFFUSE_ANGLE_NUM/2.0) * alpha_toVoxel;
                            }
                        }
                        else
                        {
                            radiance += lightSet.diffuse / (DIFFUSE_ANGLE_NUM/2.0) * alpha_toVoxel;
                        }
                    }

                    uint loc = bufferId0 * DIFFUSE_ANGLE_NUM * sensorMatrix.waveNum 
                                    + kband * DIFFUSE_ANGLE_NUM + iangle;
                    voxelRads[loc].induced += radiance;
                }
                /// hit sky and end this iteratrion.
                break;
            }

            ///////////////////////////////////////////////////
            /// Turbid or facet ground case (j -> i).
            ///////////////////////////////////////////////////
            /// get hit information.
            ShadeState sstate = GetShadeState(prd);
            voxelId = getPassedVoxelId(sstate.position, scale, normalize(ray.direction));
            bufferId = nanovdbGet(nanoVDBLink, voxelId);
            // a valid voxel and get this voxel information.
            if(bufferId >= 0)
            {
                instanceId = voxelLinks[bufferId].instanceId;
                typeId = instanceLinks[instanceId].type;
                canopyId = instanceLinks[instanceId].canopyId;
                spectralId = instanceLinks[instanceId].spectralId;
                thermalId = instanceLinks[instanceId].thermalId;
                canopy = canopies[canopyId];

                if(typeId == TYPE_VEGETATION)
                {
                    float pathLength = Vector2Distance(sstate.position - sstate.lastPosition);
                    alpha_voxel = exp(-canopies[canopyId].density * canopies[canopyId].G * pathLength);
                    alpha_toSolar = voxelDirs[bufferId].solar;

                    if(alpha_toVoxel < 0.001) break;

                    // this is used for the hotspot effect
                    if(alpha_toSolar < 0.0001) pl_toSolar = 10000.0;
                    else pl_toSolar = -log(alpha_toSolar) / canopy.G / 1.0;
                    if(alpha_toVoxel < 0.0001) pl_toVoxel = 10000.0;
                    else pl_toVoxel = -log(alpha_toVoxel) / canopy.G / 1.0;
                    float hotspot = Hotspot_Kuusk(normalize(lightSet.direction), -normalize(ray.direction), pl_toSolar, pl_toVoxel, 1.0, HSPOT);

                    for(int kband = 0; kband < sensorMatrix.waveNum; kband++)
                    {
                        float radiance = 0.0;
                        float refl = spectralMaterials[spectralId * sensorMatrix.waveNum + kband].reflectance;
                        float trans = spectralMaterials[spectralId * sensorMatrix.waveNum + kband].transmittance;

                        if(settingxml.isTemperature == 1)
                        {
                            int waveInd = sensorWaveInds[kband].value;
                            float wavelength = waveSets[waveInd].wavelength;
                            if(wavelength > 50) wavelength = wavelength/1000.0;
                            if(wavelength > 2.5)
                            {
                                // get sunlit and shaded fraction and mixed them for an average result.
                                float sunlitTemperature = thermalMaterials[thermalId].sunlitTemperature;
                                float shadedTemperature = thermalMaterials[thermalId].shadedTemperature;

                                // hot spot
                                float thermalRadiance = Planck(wavelength, sunlitTemperature) * hotspot
                                                        + Planck(wavelength, shadedTemperature) * (alpha_toVoxel - hotspot);
                                radiance += thermalRadiance * (1 - refl - trans) * (1 - alpha_voxel);
                                // // get sunlit and shaded fraction and mixed them for an average result.
                                // float sunlitTemperature = thermalMaterials[thermalId].sunlitTemperature;
                                // float shadedTemperature = thermalMaterials[thermalId].shadedTemperature;
                                // float thermalRadiance = Planck(wavelength, sunlitTemperature) * alpha_toSolar 
                                //                         + Planck(wavelength, shadedTemperature) * (1 - alpha_toSolar);
                                // radiance += thermalRadiance * (1 - refl - trans) * (1 - alpha_voxel) * alpha_toVoxel;
                            }
                            else
                            {
                                // do not consider hotspot and solar in this phase.
                                radiance += 0.0;
                            }
                        }
                        else
                        {
                            radiance += 0.0;
                        }

                        // add diffuse angle direction scattering term to induced.
                        uint loc = bufferId0 * DIFFUSE_ANGLE_NUM * sensorMatrix.waveNum 
                                    + kband * DIFFUSE_ANGLE_NUM + iangle;
                        // atomicAdd(voxelRads[loc].induced, radiance, gl_ScopeDevice,gl_StorageSemanticsBuffer,gl_SemanticsRelaxed);
                        voxelRads[loc].induced += radiance;
                    }
                    
                    alpha_toVoxel = alpha_toVoxel * alpha_voxel;
                }
                if(typeId == TYPE_SOIL)
                {
                    alpha_voxel = 1.0;
                    alpha_toVoxel = alpha_toVoxel * alpha_voxel;
                    alpha_toSolar = voxelDirs[bufferId].solar;

                    // this is used for the hotspot effect
                    if(alpha_toSolar < 0.0001) pl_toSolar = 10000.0;
                    else pl_toSolar = -log(alpha_toSolar) / canopy.G / 1.0;
                    if(alpha_toVoxel < 0.0001) pl_toVoxel = 10000.0;
                    else pl_toVoxel = -log(alpha_toVoxel) / canopy.G / 1.0;
                    float hotspot = Hotspot_Kuusk(normalize(lightSet.direction), -normalize(ray.direction), pl_toSolar, pl_toVoxel, 1.0, HSPOT);

                    for(int kband = 0; kband < sensorMatrix.waveNum; kband++)
                    {
                        float radiance = 0.0;
                        float refl = spectralMaterials[spectralId * sensorMatrix.waveNum + kband].reflectance;
                        float trans = spectralMaterials[spectralId * sensorMatrix.waveNum + kband].transmittance;
                        if(settingxml.isTemperature == 1)
                        {
                            int waveInd = sensorWaveInds[kband].value;
                            float wavelength = waveSets[waveInd].wavelength;
                            if(wavelength > 50) wavelength = wavelength/1000.0;
                            if(wavelength > 2.5)
                            {
                                // get sunlit and shaded fraction and mixed them for an average result.
                                float sunlitTemperature = thermalMaterials[thermalId].sunlitTemperature;
                                float shadedTemperature = thermalMaterials[thermalId].shadedTemperature;

                                // hotspot
                                float thermalRadiance = Planck(wavelength, sunlitTemperature) * hotspot 
                                                        + Planck(wavelength, shadedTemperature) * (alpha_toVoxel - hotspot);
                                radiance += thermalRadiance * (1 - refl - trans);
                                // // get sunlit and shaded fraction and mixed them for an average result.
                                // float sunlitTemperature = thermalMaterials[thermalId].sunlitTemperature;
                                // float shadedTemperature = thermalMaterials[thermalId].shadedTemperature;
                                // float thermalRadiance = Planck(wavelength, sunlitTemperature) * alpha_toSolar 
                                //                         + Planck(wavelength, shadedTemperature) * (1 - alpha_toSolar);
                                // radiance += thermalRadiance * alpha_toVoxel * (1 - refl - trans);
                            }
                            else
                            {
                                radiance += 0.0;
                            }
                        }
                        else
                        {
                            radiance += 0.0;
                        }

                        // add diffuse angle direction scattering term to induced.
                        uint loc = bufferId0 * DIFFUSE_ANGLE_NUM * sensorMatrix.waveNum 
                                    + kband * DIFFUSE_ANGLE_NUM + iangle;
                        // atomicAdd(voxelRads[loc].induced, radiance, gl_ScopeDevice,gl_StorageSemanticsBuffer,gl_SemanticsRelaxed);
                        voxelRads[loc].induced += radiance;
                    }
                    break;
                }
            }

            //// change ray origin position to hit position; and avoid self collide.
            ray = Ray(sstate.position, directioni);
            ffnormal = sstate.normal;
            ray.origin = OffsetRay(ray.origin, dot(ray.direction, ffnormal) > 0 ? ffnormal : -ffnormal);
        }
    }

    return false;
}







void main()
{
    //------------------------------------------------------------
    // Initialization for the position and SSBO index
    //------------------------------------------------------------
    // get bufferId, voxelId, instanceId and typeId
    uint bufferId0 = uint(gl_GlobalInvocationID.x);
    ivec3 voxelId0 = voxelLinks[bufferId0].voxelId;
    // Get nanoVDBLink: from voxelId to bufferId
    NanoVDBLink nanoVDBLink = nanovdbInit();

    // get center position of a voxel
    float scale = settingxml.scale;
    vec3 semiRange = settingxml.scale * settingxml.voxelSize/2.0;
    vec3 voxelPos0 = vec3(voxelId0.x + scale/2.0, voxelId0.y + scale/2.0, voxelId0.z + scale/2.0);

    // solar direction.
    vec3 lightDirection = normalize(lightSet.direction);
    
    // calculate the transmittance from voxel to solar.
    TraversalDirection(lightDirection);

    // initialize induced and cumulated, both are set 0.
    for(int kband = 0; kband<sensorMatrix.waveNum; kband++)
    {
        for(int iangle = 0; iangle < DIFFUSE_ANGLE_NUM; iangle++)
        {
            uint loc = bufferId0 * DIFFUSE_ANGLE_NUM * sensorMatrix.waveNum + kband * DIFFUSE_ANGLE_NUM + iangle;
            voxelRads[loc].cumulated = 0.0;
            voxelRads[loc].induced = 0.0;
            // voxelRads[loc].diffuse = 0.0;
        }
    }

    // calculate the primary scattering term and store in voxelRads.induced.
    Voxel_raytracing_diffuse_single(voxelPos0, bufferId0, nanoVDBLink);

    // set cumulate as induced.
    // here is voxel zero scattering, receive the sky contribution and other voxel emittering term.
    // induced = Lsky + Le(j), cumulated  = induced.
    for(int kband = 0; kband < sensorMatrix.waveNum; kband++)
    {
        for(int iangle = 0; iangle< DIFFUSE_ANGLE_NUM; iangle++)
        {
            uint loc = bufferId0 * sensorMatrix.waveNum * DIFFUSE_ANGLE_NUM + kband * DIFFUSE_ANGLE_NUM + iangle;
            atomicStore(voxelRads[loc].cumulated, voxelRads[loc].induced, gl_ScopeDevice,gl_StorageSemanticsBuffer,gl_SemanticsRelaxed);
            // atomicStore(voxelRads[loc].diffuse, voxelRads[loc].induced, gl_ScopeDevice,gl_StorageSemanticsBuffer,gl_SemanticsRelaxed);
        }
    }


}