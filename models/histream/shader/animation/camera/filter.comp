#version 450
layout(local_size_x=8,local_size_y=8)in;
layout(std430,binding=0)readonly buffer IR{float ir[];};
layout(std430,binding=1)readonly buffer RGB{vec4 rgb[];};
layout(std430,binding=2)readonly buffer Packed{vec4 packed[];};
layout(std430,binding=3)writeonly buffer Filtered{vec4 filtered[];};
layout(push_constant)uniform P{ivec4 image;vec4 sigma;}pc;
void main(){
    ivec2 p=ivec2(gl_GlobalInvocationID.xy);if(any(greaterThanEqual(p,pc.image.xy)))return;
    vec4 sum=vec4(0),weights=vec4(0);int r0=int(ceil(3.*pc.sigma.x)),r1=int(ceil(3.*pc.sigma.y));
    for(int k=-12;k<=12;k++){
        vec4 w=vec4(0);if(abs(k)<=r0)w.x=pc.sigma.x<.01?(k==0?1.:0.):exp(-float(k*k)/(2.*pc.sigma.x*pc.sigma.x));
        if(abs(k)<=r1)w.yzw=vec3(pc.sigma.y<.01?(k==0?1.:0.):exp(-float(k*k)/(2.*pc.sigma.y*pc.sigma.y)));
        if(all(equal(w,vec4(0))))continue;
        ivec2 q=clamp(p+(pc.image.z==0?ivec2(k,0):ivec2(0,k)),ivec2(0),pc.image.xy-1);int j=q.y*pc.image.x+q.x;
        vec4 v=pc.image.z==0?vec4(ir[j],rgb[j].xyz):packed[j];sum+=w*v;weights+=w;
    }
    filtered[p.y*pc.image.x+p.x]=sum/max(weights,vec4(1e-9));
}
