#version 450
layout(local_size_x=8,local_size_y=8)in;
layout(std430,binding=0)readonly buffer Source{vec4 source[];};
layout(std430,binding=1)buffer Accumulated{vec4 accumulated[];};
layout(push_constant)uniform P{ivec4 image;ivec4 detector;vec4 optics;vec4 rotation;vec4 offset;}pc;
vec4 bilinear(vec2 q){
    q=clamp(q,vec2(0),vec2(pc.image.xy-1));ivec2 a=ivec2(floor(q)),b=min(a+1,pc.image.xy-1);vec2 f=fract(q);
    return mix(mix(source[a.y*pc.image.x+a.x],source[a.y*pc.image.x+b.x],f.x),mix(source[b.y*pc.image.x+a.x],source[b.y*pc.image.x+b.x],f.x),f.y);
}
vec2 project(vec2 p){
    vec2 center=vec2(pc.image.xy)*.5;vec3 v=vec3((p-center)/pc.optics.x,1.);
    float c=cos(pc.rotation.x),s=sin(pc.rotation.x);v=vec3(c*v.x+s*v.z,v.y,-s*v.x+c*v.z);
    c=cos(pc.rotation.y);s=sin(pc.rotation.y);v=vec3(v.x,c*v.y-s*v.z,s*v.y+c*v.z);
    c=cos(pc.rotation.z);s=sin(pc.rotation.z);v.xy=mat2(c,s,-s,c)*v.xy;
    return center+v.xy/max(v.z,.1)*pc.optics.x-.5;
}
void main(){
    ivec2 p=ivec2(gl_GlobalInvocationID.xy);if(any(greaterThanEqual(p,pc.detector.xy)))return;
    vec4 value=vec4(0);vec2 center=vec2(pc.image.xy)*.5,scale=vec2(pc.image.xy)/vec2(pc.detector.xy);
    // Rectangular pixel aperture, normalized irradiance average,4x4 quadrature.
    for(int y=0;y<4;y++)for(int x=0;x<4;x++){
        vec2 aperture=((vec2(x,y)+.5)/4.-.5)*pc.optics.z;
        vec2 q=(vec2(p)+.5+pc.offset.xy+aperture)*scale;
        q=center+(q-center)*pc.optics.y;vec4 v=bilinear(project(q));
        value+=pc.image.w==0?vec4(v.x,v.x,v.x,0):vec4(v.yzw,0);
    }
    int index=p.y*pc.detector.x+p.x;vec4 contribution=value*(pc.optics.w/16.);
    accumulated[index]=pc.image.z!=0?contribution:accumulated[index]+contribution;
}
