#version 460
#extension GL_EXT_ray_query : require
layout(local_size_x=4,local_size_y=4,local_size_z=4) in;
layout(binding=0) uniform accelerationStructureEXT sceneAS;
layout(std430,binding=1) writeonly buffer Mask {uint solid[];};
layout(push_constant) uniform Push {vec4 origin;ivec4 grid;} pc;
void main(){
    ivec3 i=ivec3(gl_GlobalInvocationID.xyz);if(any(greaterThanEqual(i,pc.grid.xyz)))return;
    vec3 p=pc.origin.xyz+(vec3(i)+.5)*pc.origin.w;bool occupied=p.z<.35;
    for(int axis=0;axis<3&&!occupied;axis++)for(int sign=-1;sign<=1;sign+=2){
        vec3 d=vec3(0);d[axis]=float(sign);rayQueryEXT q;
        rayQueryInitializeEXT(q,sceneAS,gl_RayFlagsOpaqueEXT|gl_RayFlagsTerminateOnFirstHitEXT,0xff,p,.001,d,.70*pc.origin.w);
        while(rayQueryProceedEXT(q)){}
        occupied=occupied||rayQueryGetIntersectionTypeEXT(q,true)==gl_RayQueryCommittedIntersectionTriangleEXT;
    }
    solid[(i.z*pc.grid.y+i.y)*pc.grid.x+i.x]=occupied?1:0;
}
