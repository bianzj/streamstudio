float GammaR[DIFFUSE_ANGLE_NUM * DIFFUSE_ANGLE_NUM];
float GammaT[DIFFUSE_ANGLE_NUM * DIFFUSE_ANGLE_NUM];
// from solar direction to selected direction;
float GammaSR[DIFFUSE_ANGLE_NUM];
float GammaST[DIFFUSE_ANGLE_NUM];

// Opaque cells end a diffuse ray; turbid vegetation planes do not (a plane's
// front cell is its own vegetation voxel).
bool isSolidVoxel(int bufferId)
{
    if (bufferId < 0) return false;
    uint type = meshLinks[instanceLinks[voxelLinks[bufferId].instanceId].meshId].type;
    return type == TYPE_BUILDING || type == TYPE_SOIL || type == TYPE_WATER;
}

uint voxelRadiationIndex(uint bufferId, uint offset)
{
    return bufferId * (uint(DIFFUSE_ANGLE_NUM) + 2u * uint(setting.n_wave)) + offset;
}

uint voxelBandRadiationIndex(uint bufferId, uint band)
{
    return voxelRadiationIndex(bufferId, uint(DIFFUSE_ANGLE_NUM) + band);
}

// Incident radiance of one collision order. Orders alternate between the two
// fields so a pass reads order k-1 of other voxels while writing order k.
uint voxelOrderRadiationIndex(uint bufferId, uint band)
{
    return voxelRadiationIndex(bufferId,
        uint(DIFFUSE_ANGLE_NUM) + uint(setting.n_wave) + band);
}

float readCollisionOrder(uint bufferId, uint band, int order)
{
    VoxelRad record = voxelRads[voxelOrderRadiationIndex(bufferId, band)];
    return finiteNonnegative((order & 1) == 1 ? record.cumulated : record.induced);
}

void writeCollisionOrder(uint bufferId, uint band, int order, float value)
{
    uint index = voxelOrderRadiationIndex(bufferId, band);
    if ((order & 1) == 1) voxelRads[index].cumulated = value;
    else voxelRads[index].induced = value;
}

float voxelSurfaceEmission(float wavelength, float sunlitTemperature,
                           float shadedTemperature, float sunlitFraction,
                           float emissivity, float pathTransmittance)
{
    // Optical transport is normalized illumination; thermal emission uses
    // Planck spectral radiance in W m-2 sr-1 um-1, with temperatures in K.
    if(wavelength <= 5000.0) return 0.0;
    float fraction = clamp(sunlitFraction, 0.0, 1.0);
    float radiance = fraction * Planck(wavelength, sunlitTemperature)
        + (1.0 - fraction) * Planck(wavelength, shadedTemperature);
    return radiance * clamp(emissivity, 0.0, 1.0)
        * clamp(pathTransmittance, 0.0, 1.0);
}

float voxelSurfaceEmissivity(MeshLink surface, int band,
                             vec3 outgoingDirection, vec3 normal)
{
    uint spectralIndex = surface.spectralId * uint(setting.n_wave) + uint(band);
    float refl = spectralMaterials[spectralIndex].reflectance;
    float trans = spectralMaterials[spectralIndex].transmittance;
    return surface.type == TYPE_WATER
        ? clamp(1.0 - waterDirectionalReflectance(surface.bioId, refl,
            outgoingDirection, normal) - trans, 0.0, 1.0)
        : surfaceThermalEmissivity(refl, trans, outgoingDirection, normal,
            surface.angularEffectStrength);
}

vec3 rotateDiffuseAzimuth(vec3 direction, float angle)
{
    float c = cos(angle);
    float s = sin(angle);
    return vec3(c * direction.x + s * direction.z,
                direction.y,
               -s * direction.x + c * direction.z);
}

float diffuseAzimuthOffset(ivec3 voxelId)
{
    // Independent Cranley-Patterson rotations provide unbiased samples for
    // compact emitters. The image pass filters these estimates on continuous
    // soil surfaces, so the variance does not appear as pixel noise.
    float hashValue = dot(vec3(voxelId), vec3(12.9898, 78.233, 37.719));
    return fract(sin(hashValue) * 43758.5453) * M_TWO_PI;
}

// calculate the scattering phase function from solar angle to N angles.
void Scattering_phase_function_solar_diffuse(float azimuthOffset)
{
    vec3 directioni = normalize(lightSet.direction);
    for(int jangle = 0; jangle < DIFFUSE_ANGLE_NUM; jangle++)
    {
        vec3 directionj = normalize(rotateDiffuseAzimuth(
            DIFFUSE_DIRECTIONS[jangle], azimuthOffset));
        // Scattered light propagates back along -directionj towards the receiver;
        // with directioni towards the sun the helper's angle is then exactly the
        // incident/scattered propagation angle.
        vec2 gamma = scattering_phase_function_direct_XZY_paper(directioni, directionj);
        GammaSR[jangle] = gamma.x;
        GammaST[jangle] = gamma.y;
    }
}

// calculate the scattering phase function from N angles to N angles.
void Scattering_phase_function_diffuse(float azimuthOffset)
{
    for(int iangle = 0; iangle < DIFFUSE_ANGLE_NUM; iangle++)
    {
        vec3 directioni = normalize(rotateDiffuseAzimuth(
            DIFFUSE_DIRECTIONS[iangle], azimuthOffset));
        for(int jangle = 0; jangle < DIFFUSE_ANGLE_NUM; jangle++)
        {
            vec3 directionj = normalize(rotateDiffuseAzimuth(
                DIFFUSE_DIRECTIONS[jangle], azimuthOffset));
            vec2 gamma = scattering_phase_function_direct_XZY_paper(directioni, -directionj);
            GammaR[iangle * DIFFUSE_ANGLE_NUM + jangle] = gamma.x;
            GammaT[iangle * DIFFUSE_ANGLE_NUM + jangle] = gamma.y;
        }
    }
}

// calculate the diffuse term.
bool voxel_raytracing_diffuse(vec3 voxelPos0, uint bufferId0, NanoVDBLink nanoVDBLink,
 int kwave,float Esun,float Esky, int kiter, float azimuthOffset)
{

  float G,density;
  float scale = setting.scale;
    vec3 semiRange = vec3(floor(setting.voxelSize.x/2.0+0.5),0,floor(setting.voxelSize.z/2.0+0.5));
  // semiRange = vec3(0,0,0);
  // i:induced direction for the selected voxel; 0 original
  // j:induced direction for the traveled voxel;
  // s:solar direction
  vec3 directioni,directioni0,directionj,directionj0;
  vec3 directions = normalize(lightSet.direction);
  float cosSolar = abs(normalize(lightSet.direction).y);
  int bufferId,alignBufferId;
  uint spectralId,thermalId,canopyId;
  vec2 gammart;
  int n_wave = setting.n_wave;
  float alpha_voxel,alpha_toSolar,alpha_toVoxel;
  uint typeId,meshId;
  uint instanceId,lastInstanceId,alignInstanceId;
  uint bufferIdPlus0;
  ivec3 voxelId,alignVoxelId;
  float pl_toSolar,pl_toVoxel,refl,trans,emis,gamma,wavelength;
  float sunlitTemperature,sunlitRadiance,shadedTemperature,shadedRadiance,thermalRadiance;
  ivec3 voxelRes = ivec3(setting.voxelSize);

  InstanceLink instanceLink;
  MeshLink meshLink;
  Canopy canopy;


  ivec3 voxelId0 = voxelLinks[bufferId0].voxelId;
  uint instanceId0 = voxelLinks[bufferId0].instanceId;
  uint meshId0 = instanceLinks[instanceId0].meshId;
  uint typeId0 = meshLinks[meshId0].type;
  
  bool isvegfirst = true;
  bool surfaceReceiver = typeId0 == TYPE_BUILDING || typeId0 == TYPE_SOIL || typeId0 == TYPE_WATER;
  ////////////////////////////////////////////////////////
  //  Iteration in difuse angle
  ////////////////////////////////////////////////////////
  for(uint iangle = 0; iangle < DIFFUSE_ANGLE_NUM; iangle++)
  {
    directioni0 = rotateDiffuseAzimuth(
        DIFFUSE_DIRECTIONS[iangle], azimuthOffset);
    directioni = normalize(directioni0);
    Ray ray = Ray(voxelPos0, directioni);
    ConfigureCone(voxelPos0, directioni, 0.0, 0.0);
    alpha_toSolar = 1.0;
    alpha_toVoxel = 1.0;
	  voxelRads[voxelRadiationIndex(bufferId0, iangle)].induced = 0.0;

    // A solid surface only receives radiance through its upper hemisphere.
    // Rays into the object interior would hit its own inner facets and add the
    // object's emission/reflection to its own incident environment.
    if(surfaceReceiver && directioni0.y < 0.0) continue;

    /////////////////////////////////////////////////////
    /// Iteration in travel step
    /////////////////////////////////////////////////////
    int kstep = 0;
    vec3 ffnormal;
    for(kstep = 0;kstep<=setting.maxStep;kstep++)
    //  for(kstep = 0;kstep<=5;kstep++)
    { 
      alpha_voxel = 1.0;
      ClosestHit(ray,0.00001);
      if(prd.hitT == INFINITY)
      {
        //////////////////////////////
        /// Atmospheric case
        /////////////////////////////

        // add save the sky contribution
        // sky contribution: lightSet.Rli*waveSets[kwave].diffuse*0.001
        alpha_toVoxel *= TurbidEscapeTransmittance(ray.origin, ray.direction);
        if(directioni0.y >= 0)
        {
           float skyrad = alpha_toVoxel*Esky;
           //skyrad = 1000;
          //skyrad = 0.5;
          uint index = voxelRadiationIndex(bufferId0, iangle);
          atomicAdd(voxelRads[index].induced,
              skyrad,
              gl_ScopeDevice,gl_StorageSemanticsBuffer,gl_SemanticsRelaxed);
        }
        alpha_toVoxel = 0.001;
        break;
      }

      //break;
      // get hit information
      ShadeState sstate = GetShadeState(prd);

      // get voxelId and alignVoxelId
      voxelId = getVoxelIdSemi(sstate.position,semiRange,scale,directioni,alignVoxelId);
      // get bufferId and alignBufferId;
      // if bufferId/alignBufferId = -1, this voxel is blank;
      bufferId = nanovdbGet(nanoVDBLink,voxelId);
      alignBufferId = nanovdbGet(nanoVDBLink,alignVoxelId);
      //////////////////////////////
      /// Trubid case
      /////////////////////////////
      if(bufferId >= 0)
      {
          // a valid voxel and get voxel information 
          // such as instanceId, typeId, spectralId, thermalId, canopyId
          instanceId = voxelLinks[bufferId].instanceId;
          meshId = instanceLinks[instanceId].meshId;
          meshLink = meshLinks[meshId];
          canopyId = meshLink.canopyId;
          typeId = meshLink.type;
          spectralId = meshLink.spectralId;
          thermalId = meshLink.thermalId;
          canopy = canopies[canopyId];
          uint spectralIdBase = spectralId*n_wave;


          //////////////////////////////
          /// Trubid case
          /////////////////////////////
          if(typeId == TYPE_VEGETATION)
          {


              G = canopy.G;
              density = isParticipatingMedium(canopy) ? canopy.density
                  : ResolveTurbidDensity(bufferId, canopyId, voxelId, voxelRes);
              float pathLength = Vector2Distance(sstate.position - sstate.lastPosition);
              alpha_voxel = isParticipatingMedium(canopy)
                  ? canopyVoxelTransmittance(canopy, density, G, pathLength, scale)
                  : ResolveSpatialInteraction(bufferId, density, G,
                      sstate.lastPosition, sstate.position, scale).x;
              alpha_toSolar = voxelDirs[bufferId].solar;

            // get the phase function for solar direction to induced direction 
            gammart.x = GammaSR[iangle];
            gammart.y = GammaST[iangle];
            sunlitTemperature = thermalMaterials[thermalId].sunlitTemperature;
            shadedTemperature = thermalMaterials[thermalId].shadedTemperature;
            /////////////////////////////////////////////////////
            /// Iteration in BAND
            /////////////////////////////////////////////////////

              // THERMAL
              wavelength = wave[kwave];


              // SPECTRAL
              trans = spectralMaterials[spectralId*n_wave+kwave].transmittance;
              refl = spectralMaterials[spectralId*n_wave+kwave].reflectance;
              emis = 1 - trans - refl;
              float gamma = clamp(abs(gammart.x)*(refl + trans) + gammart.y*trans, 0.0, 1.0);
              float radiance = 0;
               //////////////////////////////
              /// Multiple case
              /////////////////////////////
              // if(kiter > 0)
              // {
              //   for(int jangle=0;jangle<DIFFUSE_ANGLE_NUM;jangle++)
              //   {
              //       float radiancej = voxelRads[bufferId*DIFFUSE_ANGLE_NUM+iangle].cumulated;
              //       directionj0 = (DIFFUSE_DIRECTIONS[jangle]);
              //       gammart.x = GammaR[iangle*DIFFUSE_ANGLE_NUM+jangle];
              //       gammart.y = GammaT[iangle*DIFFUSE_ANGLE_NUM+jangle];
              //       gamma =   abs(gammart.x)*(refl + trans)+ abs(gammart.y)*trans;  
              //       gamma = clamp(gamma,0,1);
              //       radiance= radiance + radiancej * gamma* alpha_toVoxel*(1-alpha_voxel);  
              //   }
              //   radiance = radiance / DIFFUSE_ANGLE_NUM;
              // }
              //////////////////////////////
              // emitter
              /////////////////////////////
              // thermalRadiance = 100;
              if(isParticipatingMedium(canopy)) {
                float removedFraction = 1.0 - alpha_voxel;
                float scatteringFraction = removedFraction * clamp(canopy.scatteringAlbedo, 0.0, 1.0);
                float absorptionFraction = removedFraction - scatteringFraction;
                float mediumTemperature = canopy.fixedTemperature > 0.0
                    ? canopy.fixedTemperature : 0.5 * (sunlitTemperature + shadedTemperature);
                radiance += Planck(wavelength, mediumTemperature) * canopy.emissionScale
                    * absorptionFraction * alpha_toVoxel;
                float scatteringPhase = mediumPhaseHG(canopy,
                    dot(normalize(lightSet.direction), directioni));
                radiance += alpha_toSolar * Esun / max(cosSolar, 0.001)
                    * scatteringFraction * scatteringPhase * alpha_toVoxel;
              } else {
                if(wavelength > 5000){
                  sunlitRadiance = Planck(wavelength,sunlitTemperature);
                  shadedRadiance = Planck(wavelength,shadedTemperature);
                  thermalRadiance = (1-alpha_toSolar)*shadedRadiance + alpha_toSolar*sunlitRadiance;
                  radiance+= (thermalRadiance*(1-alpha_voxel)*emis* alpha_toVoxel);
                }
              // Single scattering of the beam, same as the image pass: pi*L = Gamma/G * E * interception.
              radiance += alpha_toSolar * gamma / max(G, 0.000001) * Esun * alpha_toVoxel * (1 - alpha_voxel);
              }
              //////////////////////////////
              /// Solar 
              /////////////////////////////
              //////////////////////////////
              /// Save back
              /////////////////////////////
              atomicAdd(voxelRads[voxelRadiationIndex(bufferId0, iangle)].induced,radiance,
                  gl_ScopeDevice,gl_StorageSemanticsBuffer,gl_SemanticsRelaxed);
            alpha_toVoxel = alpha_toVoxel * alpha_voxel;
            if(alpha_toVoxel < 0.01) break; 
          }  
      }// if vegetation


      if (isSolidVoxel(alignBufferId))
      {
        alignBufferId = ResolveVoxelSurfaceState(alignBufferId, sstate.normal);
        //////////////////////////////
        /// facet case
        /////////////////////////////
       
        
        instanceId = voxelLinks[alignBufferId].instanceId;
        meshId = instanceLinks[instanceId].meshId;
        meshLink = meshLinks[meshId];
        typeId = meshLink.type;
        canopyId = meshLink.canopyId;
        spectralId = meshLink.spectralId;
        thermalId = meshLink.thermalId;
        uint spectralIdBase = spectralId*n_wave;

    
        alpha_toSolar = voxelDirs[alignBufferId].solar;
        if (dot(sstate.normal, lightSet.direction) <= 0.0) alpha_toSolar = 0.0;
        vec3 wo = directioni;  // FROM SELECTED VOXEL OUT TO HIT FACET  
        vec3 wi = lightSet.direction; // FROM SELECTED VOXEL OUT TO SOLAR
        vec3 ffnormal = sstate.normal;
        bool inSameSides = IsSameSide(wo,wi,ffnormal);
        // THERMAL
        sunlitTemperature = thermalMaterials[thermalId].sunlitTemperature;
        shadedTemperature = thermalMaterials[thermalId].shadedTemperature;
        float radiance=0;
          wavelength = wave[kwave];
          // SPECTRAL
          trans = spectralMaterials[spectralId*n_wave+kwave].transmittance;
          refl = spectralMaterials[spectralId*n_wave+kwave].reflectance;
          float angularStrength = meshLink.angularEffectStrength;
          emis = voxelSurfaceEmissivity(meshLink, kwave, -directioni, ffnormal);
          // //////////////////////////////
          // /// Multiple case
          // /////////////////////////////
          // if(kiter > 0)
          // {
          //   for(int jangle=0;jangle<DIFFUSE_ANGLE_NUM;jangle++)
          //   {
          //       directionj0 = (DIFFUSE_DIRECTIONS[jangle]);
          //       bool inSameSide = IsSameSide(directioni,directionj0,ffnormal);
          //       if(!inSameSide) continue;
          //       float radiancej = voxelRads[bufferId*DIFFUSE_ANGLE_NUM+iangle].cumulated;
          //       radiance= radiance + radiancej * refl* alpha_toVoxel;  
          //   }
          //   radiance = radiance/DIFFUSE_ANGLE_NUM;
          // }
          
          ////////////////////////////////
          // SOLAR CASE
          ///////////////////////////////
          if(inSameSides)
          {
            float surfaceWeight = typeId == TYPE_WATER
                ? waterCoxMunkWeight(meshLink.bioId, refl, wi, wo, ffnormal)
                : backgroundReflectanceWeight(
                    refl, wi, wo, ffnormal, angularStrength);
            // Beam irradiance on the facet, as in the image pass.
            float cosIncidence = abs(dot(normalize(ffnormal), normalize(wi)));
            radiance += (surfaceWeight * cosIncidence * Esun * alpha_toSolar * alpha_toVoxel);
          }
          // A solid hit occludes everything behind it, but its own thermal
          // emission reaches this voxel through the preceding medium.
          radiance += voxelSurfaceEmission(wavelength, sunlitTemperature,
              shadedTemperature, alpha_toSolar, emis, alpha_toVoxel);
          //////////////////////////////
          /// Save back
          /////////////////////////////
     
          atomicAdd(voxelRads[voxelRadiationIndex(bufferId0, iangle)].induced,radiance,
              gl_ScopeDevice,gl_StorageSemanticsBuffer,gl_SemanticsRelaxed);

          alpha_toVoxel = 0;
          break;
      }// if facet


      ray = Ray(sstate.position,directioni);
      ffnormal  = sstate.normal;
      ray.origin = OffsetRay(ray.origin, dot(ray.direction, ffnormal) > 0 ? ffnormal : -ffnormal);
    }

    if((kstep >= setting.maxStep) && (alpha_toVoxel > 0.05))
    {
        float skyrad = alpha_toVoxel*Esky;
        //skyrad = 0.5;
        uint index = voxelRadiationIndex(bufferId0, iangle);
        atomicAdd(voxelRads[index].induced,
            skyrad,
            gl_ScopeDevice,gl_StorageSemanticsBuffer,gl_SemanticsRelaxed);
    }
  }
  return false;
}

#define SPECTRAL_PACKET_SIZE 4

// Trace geometry once and evaluate up to four adjacent wavelengths along the
// same ordered intersections. Structural extinction is wavelength-independent
// in this model; only material scattering/emission is evaluated per band.
void voxel_raytracing_diffuse_packet(
    vec3 voxelPos0, uint bufferId0, NanoVDBLink nanoVDBLink,
    int firstBand, int bandCount,
    float packetEsun[SPECTRAL_PACKET_SIZE],
    float packetEsky[SPECTRAL_PACKET_SIZE],
    float azimuthOffset,
    out float packetRadiance[SPECTRAL_PACKET_SIZE])
{
  for(int bandOffset = 0; bandOffset < SPECTRAL_PACKET_SIZE; ++bandOffset)
    packetRadiance[bandOffset] = 0.0;

  float scale = setting.scale;
  vec3 semiRange = vec3(floor(setting.voxelSize.x / 2.0 + 0.5), 0,
                       floor(setting.voxelSize.z / 2.0 + 0.5));
  ivec3 voxelRes = ivec3(setting.voxelSize);
  float cosSolar = abs(normalize(lightSet.direction).y);
  ivec3 voxelId0 = voxelLinks[bufferId0].voxelId;
  uint receiverType = meshLinks[instanceLinks[voxelLinks[bufferId0].instanceId].meshId].type;
  bool surfaceReceiver = receiverType == TYPE_BUILDING || receiverType == TYPE_SOIL || receiverType == TYPE_WATER;

  for(uint iangle = 0; iangle < DIFFUSE_ANGLE_NUM; ++iangle)
  {
    float directionalRadiance[SPECTRAL_PACKET_SIZE];
    float directionalCorrection[SPECTRAL_PACKET_SIZE];
    for(int bandOffset = 0; bandOffset < SPECTRAL_PACKET_SIZE; ++bandOffset) {
      directionalRadiance[bandOffset] = 0.0;
      directionalCorrection[bandOffset] = 0.0;
    }

    vec3 direction0 = rotateDiffuseAzimuth(
        DIFFUSE_DIRECTIONS[iangle], azimuthOffset);
    vec3 direction = normalize(direction0);
    // Surface receivers integrate the upper hemisphere only (see above).
    if(surfaceReceiver && direction0.y < 0.0) continue;
    Ray ray = Ray(voxelPos0, direction);
    ConfigureCone(voxelPos0, direction, 0.0, 0.0);
    float alphaToVoxel = 1.0;
    int kstep = 0;

    for(kstep = 0; kstep <= setting.maxStep; ++kstep)
    {
      ClosestHit(ray, 0.00001);
      if(prd.hitT == INFINITY)
      {
        alphaToVoxel *= TurbidEscapeTransmittance(ray.origin, ray.direction);
        if(direction0.y >= 0) {
          for(int bandOffset = 0; bandOffset < bandCount; ++bandOffset)
            compensatedAdd(directionalRadiance[bandOffset],
                directionalCorrection[bandOffset],
                alphaToVoxel * packetEsky[bandOffset]);
        }
        alphaToVoxel = 0.001;
        break;
      }

      ShadeState sstate = GetShadeState(prd);
      ivec3 alignVoxelId;
      ivec3 voxelId = getVoxelIdSemi(
          sstate.position, semiRange, scale, direction, alignVoxelId);
      int bufferId = nanovdbGet(nanoVDBLink, voxelId);
      int alignBufferId = nanovdbGet(nanoVDBLink, alignVoxelId);

      if(bufferId >= 0)
      {
        uint instanceId = voxelLinks[bufferId].instanceId;
        uint meshId = instanceLinks[instanceId].meshId;
        MeshLink meshLink = meshLinks[meshId];
        uint canopyId = meshLink.canopyId;
        uint typeId = meshLink.type;
        uint spectralId = meshLink.spectralId;
        uint thermalId = meshLink.thermalId;
        Canopy canopy = canopies[canopyId];

        if(typeId == TYPE_VEGETATION)
        {
          float density = isParticipatingMedium(canopy) ? canopy.density
              : ResolveTurbidDensity(bufferId, canopyId, voxelId, voxelRes);
          float pathLength = Vector2Distance(
              sstate.position - sstate.lastPosition);
          float alphaVoxel = isParticipatingMedium(canopy)
              ? canopyVoxelTransmittance(
                    canopy, density, canopy.G, pathLength, scale)
              : ResolveSpatialInteraction(bufferId, density, canopy.G,
                    sstate.lastPosition, sstate.position, scale).x;
          float alphaToSolar = voxelDirs[bufferId].solar;
          float gammaR = GammaSR[iangle];
          float gammaT = GammaST[iangle];
          float sunlitTemperature =
              thermalMaterials[thermalId].sunlitTemperature;
          float shadedTemperature =
              thermalMaterials[thermalId].shadedTemperature;

          for(int bandOffset = 0; bandOffset < bandCount; ++bandOffset)
          {
            int kwave = firstBand + bandOffset;
            float wavelength = wave[kwave];
            float trans = spectralMaterials[
                spectralId * uint(setting.n_wave) + uint(kwave)].transmittance;
            float refl = spectralMaterials[
                spectralId * uint(setting.n_wave) + uint(kwave)].reflectance;
            float emis = 1.0 - trans - refl;
            float gamma = clamp(
                abs(gammaR) * (refl + trans) + gammaT * trans,
                0.0, 1.0);
            float radiance = 0.0;

            if(isParticipatingMedium(canopy)) {
              float removedFraction = 1.0 - alphaVoxel;
              float scatteringFraction = removedFraction
                  * clamp(canopy.scatteringAlbedo, 0.0, 1.0);
              float absorptionFraction =
                  removedFraction - scatteringFraction;
              float mediumTemperature = canopy.fixedTemperature > 0.0
                  ? canopy.fixedTemperature
                  : 0.5 * (sunlitTemperature + shadedTemperature);
              radiance += Planck(wavelength, mediumTemperature)
                  * canopy.emissionScale * absorptionFraction * alphaToVoxel;
              float scatteringPhase = mediumPhaseHG(
                  canopy, dot(normalize(lightSet.direction), direction));
              radiance += alphaToSolar * packetEsun[bandOffset]
                  / max(cosSolar, 0.001) * scatteringFraction
                  * scatteringPhase * alphaToVoxel;
            } else {
              if(wavelength > 5000) {
                float thermalRadiance =
                    (1.0 - alphaToSolar)
                        * Planck(wavelength, shadedTemperature)
                    + alphaToSolar
                        * Planck(wavelength, sunlitTemperature);
                radiance += thermalRadiance * (1.0 - alphaVoxel)
                    * emis * alphaToVoxel;
              }
              radiance += alphaToSolar * gamma / max(canopy.G, 0.000001)
                  * packetEsun[bandOffset]
                  * alphaToVoxel * (1.0 - alphaVoxel);
            }
            compensatedAdd(directionalRadiance[bandOffset],
                directionalCorrection[bandOffset], radiance);
          }

          alphaToVoxel *= alphaVoxel;
          if(alphaToVoxel < 0.01) break;
        }
      }

      if(isSolidVoxel(alignBufferId))
      {
        alignBufferId = ResolveVoxelSurfaceState(alignBufferId, sstate.normal);
        uint instanceId = voxelLinks[alignBufferId].instanceId;
        uint meshId = instanceLinks[instanceId].meshId;
        MeshLink surface = meshLinks[meshId];
        uint typeId = surface.type;
        uint spectralId = surface.spectralId;
        ThermalMaterial thermal = thermalMaterials[surface.thermalId];

        float alphaToSolar = dot(sstate.normal, lightSet.direction) > 0.0
            ? voxelDirs[alignBufferId].solar : 0.0;
        vec3 wo = direction;
        vec3 wi = lightSet.direction;
        vec3 faceNormal = sstate.normal;
        bool inSameSides = IsSameSide(wo, wi, faceNormal);
        float angularStrength = surface.angularEffectStrength;

        for(int bandOffset = 0; bandOffset < bandCount; ++bandOffset)
        {
            int kwave = firstBand + bandOffset;
            float refl = spectralMaterials[
                spectralId * uint(setting.n_wave) + uint(kwave)].reflectance;
            float radiance = voxelSurfaceEmission(wave[kwave],
                thermal.sunlitTemperature, thermal.shadedTemperature,
                alphaToSolar,
                voxelSurfaceEmissivity(surface, kwave, -direction, faceNormal),
                alphaToVoxel);
            if(inSameSides) {
              float surfaceWeight = typeId == TYPE_WATER
                  ? waterCoxMunkWeight(surface.bioId, refl, wi, wo, faceNormal)
                  : backgroundReflectanceWeight(
                      refl, wi, wo, faceNormal, angularStrength);
              radiance += surfaceWeight * abs(dot(normalize(faceNormal), normalize(wi)))
                  * packetEsun[bandOffset] * alphaToSolar * alphaToVoxel;
            }
            compensatedAdd(directionalRadiance[bandOffset],
                directionalCorrection[bandOffset], radiance);
        }
        alphaToVoxel = 0.0;
        break;
      }

      ray = Ray(sstate.position, direction);
      vec3 faceNormal = sstate.normal;
      ray.origin = OffsetRay(
          ray.origin,
          dot(ray.direction, faceNormal) > 0 ? faceNormal : -faceNormal);
    }

    if(kstep >= setting.maxStep && alphaToVoxel > 0.05) {
      for(int bandOffset = 0; bandOffset < bandCount; ++bandOffset)
        compensatedAdd(directionalRadiance[bandOffset],
            directionalCorrection[bandOffset],
            alphaToVoxel * packetEsky[bandOffset]);
    }

    for(int bandOffset = 0; bandOffset < bandCount; ++bandOffset)
      packetRadiance[bandOffset] += directionalRadiance[bandOffset]
          * DIFFUSE_HEMISPHERE_AVERAGE_WEIGHT;
  }
}

// Collision order k >= 2: the radiance incident on this voxel after one more
// collision of the order k-1 field held by every other voxel. Vegetation scatters
// it isotropically with the leaf albedo w; surfaces reflect it like the image
// pass. On the last explicit order the remaining orders are added as the
// geometric tail q/(1-q) of each scatterer, q = p * w, with p the canopy-scale
// recollision probability (spectral invariants).
void voxel_collision_order_packet(
    vec3 voxelPos0, uint bufferId0, NanoVDBLink nanoVDBLink,
    int firstBand, int bandCount, int order, float azimuthOffset,
    out float packetRadiance[SPECTRAL_PACKET_SIZE],
    out float packetTail[SPECTRAL_PACKET_SIZE])
{
  for(int bandOffset = 0; bandOffset < SPECTRAL_PACKET_SIZE; ++bandOffset) {
    packetRadiance[bandOffset] = 0.0;
    packetTail[bandOffset] = 0.0;
  }
  bool lastOrder = order >= setting.collisionOrders;
  float scale = setting.scale;
  vec3 semiRange = vec3(floor(setting.voxelSize.x / 2.0 + 0.5), 0,
                       floor(setting.voxelSize.z / 2.0 + 0.5));
  ivec3 voxelRes = ivec3(setting.voxelSize);
  uint receiverType = meshLinks[instanceLinks[voxelLinks[bufferId0].instanceId].meshId].type;
  bool surfaceReceiver = receiverType == TYPE_BUILDING || receiverType == TYPE_SOIL || receiverType == TYPE_WATER;

  for(uint iangle = 0; iangle < DIFFUSE_ANGLE_NUM; ++iangle)
  {
    vec3 direction0 = rotateDiffuseAzimuth(DIFFUSE_DIRECTIONS[iangle], azimuthOffset);
    vec3 direction = normalize(direction0);
    if(surfaceReceiver && direction0.y < 0.0) continue;
    Ray ray = Ray(voxelPos0, direction);
    ConfigureCone(voxelPos0, direction, 0.0, 0.0);
    float alphaToVoxel = 1.0;
    float directional[SPECTRAL_PACKET_SIZE];
    float directionalTail[SPECTRAL_PACKET_SIZE];
    for(int bandOffset = 0; bandOffset < SPECTRAL_PACKET_SIZE; ++bandOffset) {
      directional[bandOffset] = 0.0;
      directionalTail[bandOffset] = 0.0;
    }

    for(int kstep = 0; kstep <= setting.maxStep; ++kstep)
    {
      ClosestHit(ray, 0.00001);
      if(prd.hitT == INFINITY) break;

      ShadeState sstate = GetShadeState(prd);
      ivec3 alignVoxelId;
      ivec3 voxelId = getVoxelIdSemi(sstate.position, semiRange, scale, direction, alignVoxelId);
      int bufferId = nanovdbGet(nanoVDBLink, voxelId);
      int alignBufferId = nanovdbGet(nanoVDBLink, alignVoxelId);

      if(bufferId >= 0)
      {
        MeshLink meshLink = meshLinks[instanceLinks[voxelLinks[bufferId].instanceId].meshId];
        if(meshLink.type == TYPE_VEGETATION)
        {
          Canopy canopy = canopies[meshLink.canopyId];
          bool medium = isParticipatingMedium(canopy);
          float density = medium ? canopy.density
              : ResolveTurbidDensity(bufferId, meshLink.canopyId, voxelId, voxelRes);
          float alphaVoxel = medium
              ? canopyVoxelTransmittance(canopy, density, canopy.G,
                    Vector2Distance(sstate.position - sstate.lastPosition), scale)
              : ResolveSpatialInteraction(bufferId, density, canopy.G,
                    sstate.lastPosition, sstate.position, scale).x;
          float pCanopy = medium ? 0.0 : calReCor(canopy.lai);
          for(int bandOffset = 0; bandOffset < bandCount; ++bandOffset)
          {
            int kwave = firstBand + bandOffset;
            uint materialIndex = meshLink.spectralId * uint(setting.n_wave) + uint(kwave);
            float w = medium ? clamp(canopy.scatteringAlbedo, 0.0, 1.0)
                : clamp(spectralMaterials[materialIndex].reflectance
                    + spectralMaterials[materialIndex].transmittance, 0.0, 0.999);
            float incident = readCollisionOrder(uint(bufferId), uint(kwave), order - 1);
            float radiance = alphaToVoxel * (1.0 - alphaVoxel) * w * 0.5 * incident;
            directional[bandOffset] += radiance;
            if(lastOrder) {
              float q = min(pCanopy * w, 0.9);
              directionalTail[bandOffset] += radiance * q / (1.0 - q);
            }
          }
          alphaToVoxel *= alphaVoxel;
          if(alphaToVoxel < 0.01) break;
        }
      }

      if(isSolidVoxel(alignBufferId))
      {
        alignBufferId = ResolveVoxelSurfaceState(alignBufferId, sstate.normal);
        MeshLink surface = meshLinks[instanceLinks[voxelLinks[alignBufferId].instanceId].meshId];
        vec3 outgoing = -direction;
        for(int bandOffset = 0; bandOffset < bandCount; ++bandOffset)
        {
          int kwave = firstBand + bandOffset;
          uint materialIndex = surface.spectralId * uint(setting.n_wave) + uint(kwave);
          float refl = spectralMaterials[materialIndex].reflectance;
          float trans = spectralMaterials[materialIndex].transmittance;
          float incident = readCollisionOrder(uint(alignBufferId), uint(kwave), order - 1);
          float weight;
          if(wave[kwave] > 5000.0) {
            weight = surface.type == TYPE_WATER
                ? waterDirectionalReflectance(surface.bioId, refl, outgoing, sstate.normal)
                : surfaceThermalReflectance(refl, trans, outgoing, sstate.normal,
                    surface.angularEffectStrength);
          } else {
            weight = 0.5 * (surface.type == TYPE_WATER
                ? waterCoxMunkWeight(surface.bioId, refl, sstate.normal, outgoing, sstate.normal)
                : backgroundReflectanceWeight(refl, sstate.normal, outgoing,
                    sstate.normal, surface.angularEffectStrength));
          }
          directional[bandOffset] += alphaToVoxel * weight * incident;
        }
        break;
      }

      ray = Ray(sstate.position, direction);
      vec3 faceNormal = sstate.normal;
      ray.origin = OffsetRay(ray.origin,
          dot(ray.direction, faceNormal) > 0 ? faceNormal : -faceNormal);
    }

    for(int bandOffset = 0; bandOffset < bandCount; ++bandOffset) {
      packetRadiance[bandOffset] += directional[bandOffset] * DIFFUSE_HEMISPHERE_AVERAGE_WEIGHT;
      packetTail[bandOffset] += directionalTail[bandOffset] * DIFFUSE_HEMISPHERE_AVERAGE_WEIGHT;
    }
  }
}

// Runs one collision order k >= 2 for up to four bands and accumulates it
// (plus the recollision tail on the last order) into the environment field.
void runCollisionOrder(vec3 voxelPos0, uint bufferId0, NanoVDBLink nanoVDBLink,
                       int firstBand, int bandCount, float azimuthOffset)
{
  int order = setting.collisionOrder;
  const int diffuseSampleSets = 5;
  float sampled[SPECTRAL_PACKET_SIZE];
  float sampledTail[SPECTRAL_PACKET_SIZE];
  for(int bandOffset = 0; bandOffset < SPECTRAL_PACKET_SIZE; ++bandOffset) {
    sampled[bandOffset] = 0.0;
    sampledTail[bandOffset] = 0.0;
  }
  for(int kiter = 0; kiter < diffuseSampleSets; ++kiter) {
    float radiance[SPECTRAL_PACKET_SIZE];
    float tail[SPECTRAL_PACKET_SIZE];
    voxel_collision_order_packet(voxelPos0, bufferId0, nanoVDBLink, firstBand,
        bandCount, order, azimuthOffset + float(kiter) * 2.39996323, radiance, tail);
    for(int bandOffset = 0; bandOffset < bandCount; ++bandOffset) {
      sampled[bandOffset] += radiance[bandOffset];
      sampledTail[bandOffset] += tail[bandOffset];
    }
  }
  for(int bandOffset = 0; bandOffset < bandCount; ++bandOffset) {
    uint band = uint(firstBand + bandOffset);
    float radiance = sampled[bandOffset] / float(diffuseSampleSets);
    float tail = sampledTail[bandOffset] / float(diffuseSampleSets);
    writeCollisionOrder(bufferId0, band, order, radiance);
    uint environmentIndex = voxelBandRadiationIndex(bufferId0, band);
    voxelRads[environmentIndex].cumulated += radiance + tail;
    if(band == 0u)
      voxelNetRads[bufferId0].diffuseTrad = voxelRads[environmentIndex].cumulated;
  }
}

void main()
{
  //------------------------------------------------------------
  // Initialization for the position and SSBO index
  //------------------------------------------------------------
  // get bufferId, voxelId, instanceId and typeId
  uint bufferId0 = uint(gl_GlobalInvocationID.x);
  if(bufferId0 >= uint(setting.voxelCount)) return;
  ivec3 voxelId0 = voxelLinks[bufferId0].voxelId;
  if(voxelLinks[bufferId0].isValid==0) return;
  // Get nanoVDBLink: from voxelId to bufferId
  NanoVDBLink nanoVDBLink = nanovdbInit();
  ConfigureTurbidGrid(nanoVDBLink);
  uint instanceId = voxelLinks[bufferId0].instanceId;
  uint meshId = instanceLinks[instanceId].meshId;
  uint typeId0 = meshLinks[meshId].type;
  uint spectralId = meshLinks[meshId].spectralId;
  uint n_wave = setting.n_wave;
  uint spectralIdBase = spectralId * n_wave;
  int kwave = setting.n_jump;
  if(kwave < 0 || kwave >= setting.n_wave || kwave >= MAXBAND) return;

  int faceId = voxelLinks[bufferId0].faceId;
  float scale = setting.scale;
  vec3 semiRange = vec3(floor(setting.voxelSize.x/2.0+0.5),0,
                        floor(setting.voxelSize.z/2.0+0.5));
  vec3 voxelPos0 = vec3(voxelId0.x - semiRange.x,
                        voxelId0.y,
                        voxelId0.z - semiRange.z);
  getFacetIdPos(faceId, voxelPos0);
  float azimuthOffset = diffuseAzimuthOffset(voxelId0);

  if(setting.collisionOrder > 1)
  {
    int bandCount = setting.spectralBatchSize > 1
        ? min(min(setting.spectralBatchSize, SPECTRAL_PACKET_SIZE), setting.n_wave - kwave)
        : 1;
    runCollisionOrder(voxelPos0, bufferId0, nanoVDBLink, kwave, bandCount, azimuthOffset);
    return;
  }

  if(setting.spectralBatchSize > 1)
  {
    int bandCount = min(
        min(setting.spectralBatchSize, SPECTRAL_PACKET_SIZE),
        setting.n_wave - kwave);
    float packetEsun[SPECTRAL_PACKET_SIZE];
    float packetEsky[SPECTRAL_PACKET_SIZE];
    float sampledRadiance[SPECTRAL_PACKET_SIZE];
    for(int bandOffset = 0; bandOffset < SPECTRAL_PACKET_SIZE; ++bandOffset) {
      packetEsun[bandOffset] = 0.0;
      packetEsky[bandOffset] = 0.0;
      sampledRadiance[bandOffset] = 0.0;
    }
    for(int bandOffset = 0; bandOffset < bandCount; ++bandOffset) {
      float wavelength = wave[kwave + bandOffset];
      packetEsun[bandOffset] = wavelength > 5000
          ? 0.0 : lightSet.direct;
      packetEsky[bandOffset] = wavelength > 5000
          ? Planck(wavelength, lightSet.skyTemperature)
          : lightSet.diffuse;
    }

    const int diffuseSampleSets = 5;
    for(int kiter = 0; kiter < diffuseSampleSets; ++kiter) {
      float iterationOffset = azimuthOffset + float(kiter) * 2.39996323;
      Scattering_phase_function_solar_diffuse(iterationOffset);
      float iterationRadiance[SPECTRAL_PACKET_SIZE];
      voxel_raytracing_diffuse_packet(
          voxelPos0, bufferId0, nanoVDBLink, kwave, bandCount,
          packetEsun, packetEsky, iterationOffset, iterationRadiance);
      for(int bandOffset = 0; bandOffset < bandCount; ++bandOffset)
        sampledRadiance[bandOffset] += iterationRadiance[bandOffset];
    }

    for(int bandOffset = 0; bandOffset < bandCount; ++bandOffset) {
      float diffuseRadiance = sampledRadiance[bandOffset]
          / float(diffuseSampleSets);
      uint bandIndex = voxelBandRadiationIndex(
          bufferId0, uint(kwave + bandOffset));
      voxelRads[bandIndex].cumulated = diffuseRadiance;
      writeCollisionOrder(bufferId0, uint(kwave + bandOffset), 1, diffuseRadiance);
      if(kwave + bandOffset == 0)
        voxelNetRads[bufferId0].diffuseTrad = diffuseRadiance;
    }
    return;
  }
  float diffuseRadiance = 0.0;




  // set the diffuse in VNIR
  voxelNetRads[bufferId0].diffuseTrad = 0;

  // maxIteration is scattering times.
  // induced in primary time is calculated at solar file.
  if(setting.maxIteration > 1)
  {
      float Esky,Esun,wavelength;               // shortwave
      wavelength = wave[kwave];
          Esun = lightSet.direct;
          Esky = lightSet.diffuse;
          if(wavelength > 5000){
            // Longwave illumination comes from the configured sky and
            // surrounding thermal emitters, not a 6000 K solar radiance.
            Esun = 0.0;
            Esky = Planck(wavelength, lightSet.skyTemperature);
          }

          const int diffuseSampleSets = 5;
          float sampledRadiance = 0.0;
          for(int kiter = 0; kiter < diffuseSampleSets; kiter++)
          {
              // The old loop repeated exactly the same 64 rays five times.
              // Rotate each set by the golden angle and average the five
              // estimates to suppress discrete-ordinate spokes without
              // increasing the existing ray count.
              float iterationOffset = azimuthOffset
                  + float(kiter) * 2.39996323;
              Scattering_phase_function_solar_diffuse(iterationOffset);
              voxel_raytracing_diffuse(voxelPos0, bufferId0, nanoVDBLink,
                  kwave, Esun, Esky, kiter, iterationOffset);
              // This invocation exclusively owns bufferId0's directional
              // records. Other voxels supply read-only geometry/materials.
              // Order SSBO accesses without synchronizing inactive lanes.
              memoryBarrierBuffer();

              float iterationRadiance = 0.0;
              float iterationCorrection = 0.0;
              for(uint iangle=0;iangle < DIFFUSE_ANGLE_NUM;iangle++)
              {
                  uint index = voxelRadiationIndex(bufferId0, iangle);
                  voxelRads[index].cumulated = voxelRads[index].induced;
                  compensatedAdd(iterationRadiance, iterationCorrection,
                      finiteNonnegative(voxelRads[index].induced));
              }
              sampledRadiance += iterationRadiance
                  * DIFFUSE_HEMISPHERE_AVERAGE_WEIGHT;
          }// for iteration

          // Preserve incoming spectral radiance. Surface absorptance and
          // reflectance are applied later by the image pass.
          diffuseRadiance = sampledRadiance / float(diffuseSampleSets);
    }

    // Reuse the existing directional buffer for one environment value per
    // band, avoiding an additional per-voxel GPU allocation.
    uint bandIndex = voxelBandRadiationIndex(bufferId0, uint(kwave));
    voxelRads[bandIndex].cumulated = diffuseRadiance;
    writeCollisionOrder(bufferId0, uint(kwave), 1, diffuseRadiance);
    if(kwave == 0)
    {
        voxelNetRads[bufferId0].diffuseTrad = diffuseRadiance;
    }
}


