// ==========================================================================
// 文件：voxelrad_diffuse_single.comp
// 功能：VoxelRT（体元辐射）模式的漫射辐射传输着色器：对每个体元，沿 DIFFUSE_ANGLE_NUM 个离散漫射方向追踪，
//       计算到达该体元的环境（漫射）入射辐射，写入 voxelRads 供 voxelrad_image.comp 成像时读取。
// 主要模块/步骤：
//   1. 头部：扩展、include、全局表（GammaR/GammaT）
//   2. voxelRads 缓冲寻址与碰撞阶数存取（voxelRadiationIndex、voxelOrderRadiationIndex、
//      readCollisionOrder/writeCollisionOrder），光学/热红外波段判据 isThermalWavelength
//   3. 接收体求积权重：实体面余弦权重（solidHemisphereCosineSum）、植被叶投影权重
//      （leafReceiverProjectionSum）、receiverQuadratureWeight；isSolidVoxel/isOwnSolidCell
//   4. 表面发射/发射率（voxelSurfaceEmission、voxelSurfaceEmissivity）与方位偏移
//      （rotateDiffuseAzimuth、diffuseAzimuthOffset）
//   5. voxel_raytracing_diffuse：单波段一阶漫射追踪（旧路径）；
//      voxel_raytracing_diffuse_packet：同一几何同时评估 ≤4 个波段（新路径）
//   6. voxel_collision_order_packet / runCollisionOrder：第 k≥2 阶碰撞，含最后一阶的几何级数余项
//   7. main：按 collisionOrder / spectralBatchSize / maxIteration 选择路径
// 数据流：voxelLinks（体元→实例）、instanceLinks/meshLinks（网格类型、光谱/热/冠层 id）、
//         voxelDirs[].solar（由 voxelrad_solar.comp 写入的直射可见度）、lightSet（太阳/天空辐照度）
//         → voxelRads[].induced（各方向入射）→ cumulated（各波段环境辐射）与按阶数的存储；
//         band 0 同步写 voxelNetRads[].diffuseTrad。
// 与其他文件：与 VoxelEB 的漫射/多次散射约定一致（见各处“as VoxelEB”注释）；成像见 voxelrad_image.comp。
// 约定：场量为 π·L（辐照度量级），Esun 为垂直光束的辐照度，Esky 为水平天空辐照度；
//       热红外波段为 Planck 辐亮度 W m-2 sr-1 μm-1，温度 K；波长 ≤2.5 或 50~2500（nm）视为光学波段；
//       漫射方向 DIFFUSE_DIRECTIONS 为上半球离散方向，各体元绕 y 轴再加独立的方位偏移。
// ==========================================================================

#version 460
#extension GL_ARB_separate_shader_objects : enable
#extension GL_EXT_nonuniform_qualifier : enable
#extension GL_GOOGLE_include_directive : enable
#extension GL_EXT_scalar_block_layout : enable
#extension GL_EXT_ray_tracing : enable
#extension GL_EXT_ray_query : enable
#extension GL_ARB_shader_clock : enable                 // Using clockARB
#extension GL_EXT_shader_image_load_formatted : enable  // The folowing extension allow to pass images as function parameters

#extension GL_NV_shader_sm_builtins : require     // Debug - gl_WarpIDNV, gl_SMIDNV
#extension GL_ARB_gpu_shader_int64 : enable       // Debug - heatmap value
#extension GL_EXT_shader_realtime_clock : enable  // Debug - heatmap timing

#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_debug_printf : enable
#extension GL_KHR_memory_scope_semantics:require
#extension GL_EXT_shader_atomic_float: require 

// 编译开关：VOXEL_RT_BIND_ININDEX 与 VOXELRT 供 bindinglayout.h 等选择体元辐射的绑定布局（具体含义待核对）。
#define VOXEL_RT_BIND_ININDEX
#define VOXELRT 1

#include "../bindinglayout.h"
#include "../parameters.h"
#include "../global.glsl"
#include "../settings.h"
#include "../nanovdb_info.glsl"
#include "../functions.glsl"
#include "../background_hapke.glsl"
#include "../mwir_solar.glsl"
#include "../water_brdf.glsl"
#include "../shade_state_voxel.glsl"
