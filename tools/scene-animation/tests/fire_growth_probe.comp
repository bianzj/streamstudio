#version 450
#extension GL_GOOGLE_include_directive : require
#define FIRE_BINDING 0
#include "fire_sources.glsl"
layout(local_size_x=8)in;
struct Result{FireSource source;vec4 schedule;};
layout(std430,binding=1)writeonly buffer Results{Result result[];};
layout(push_constant)uniform Time{vec4 values;}pc;
void main(){int i=int(gl_GlobalInvocationID.x);if(i>=fireHeader.x)return;
    result[i].source=fireSourceAt(i,pc.values.x);
    result[i].schedule=vec4(fireGrowth(i,pc.values.x),fireReleaseScale(i,pc.values.x),fireActivity(fireSources[i],pc.values.x),float(fireGrowthCode(i))*.1);
}
